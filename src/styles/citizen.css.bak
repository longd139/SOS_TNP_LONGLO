@import url('https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&display=swap');

:root { --citizen-blue: #2563EB; --citizen-blue-dark: #1565C0; --citizen-blue-soft: #E3F2FD; --citizen-ink: #111827; --citizen-muted: #667085; --citizen-line: #DCE6F2; --citizen-soft: #F8FAFC; --citizen-radius: 16px; --citizen-space: 24px; --citizen-gap: 16px; --citizen-section-space: 64px; }
.citizen-app { color: var(--citizen-ink); background: #fff; font-family: 'Lexend', Arial, sans-serif; font-size: 15px; line-height: 1.65; }
.citizen-app *, .citizen-app *::before, .citizen-app *::after { box-sizing: border-box; }
.citizen-container { width: min(1440px, calc(100% - 64px)); margin: 0 auto; }
.citizen-topbar { background: var(--citizen-blue-dark); color: var(--citizen-blue-soft); font-size: 12px; }
.citizen-topbar-inner { min-height: 35px; display: flex; justify-content: space-between; align-items: center; gap: 18px; }
.citizen-topbar a { color: #fff; display: inline-flex; align-items: center; gap: 7px; }
.citizen-header { position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.95); border-bottom: 1px solid var(--citizen-line); backdrop-filter: blur(14px); }
.citizen-header-inner { min-height: 78px; display: flex; align-items: center; justify-content: space-between; gap: 36px; }
.citizen-brand { display: inline-flex; align-items: center; gap: 11px; color: var(--citizen-ink); text-decoration: none; min-width: max-content; }
.citizen-brand-mark { display: grid; place-items: center; width: 43px; height: 43px; border-radius: 13px; color: #fff; background: var(--citizen-blue); box-shadow: 0 9px 18px rgba(18,97,160,.2); }
.citizen-brand strong, .citizen-brand small { display: block; line-height: 1.2; }
.citizen-brand strong { font-size: 16px; letter-spacing: -.02em; }
.citizen-brand small { color: var(--citizen-muted); font-size: 11px; margin-top: 4px; }
.citizen-nav { display: flex; align-items: center; gap: 7px; }
.citizen-nav a { padding: 10px 12px; color: #536579; text-decoration: none; font-size: 14px; font-weight: 600; border-radius: 9px; }
.citizen-nav a:hover, .citizen-nav a.active { color: var(--citizen-blue-dark); background: var(--citizen-blue-soft); }
.citizen-officer-link { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--citizen-blue); border-radius: 9px; color: var(--citizen-blue-dark); background: #fff; padding: 10px 14px; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; margin-left: 8px; }
.citizen-officer-link:hover { background: var(--citizen-blue-soft); }
.citizen-menu-toggle { display: none; border: 0; background: transparent; color: var(--citizen-ink); padding: 8px; }
.citizen-hero { position: relative; overflow: hidden; color: white; background: linear-gradient(170deg, rgba(10,22,48,.90) 0%, rgba(15,40,70,.72) 38%, rgba(10,30,56,.90) 100%), url('https://images.unsplash.com/photo-1449824913935-59a10b8d2000?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat; }
.citizen-hero-grid { position: relative; z-index: 1; min-height: 518px; display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 64px; padding: 68px 0; }
.hero-indicators { position: relative; z-index: 1; display: flex; gap: 7px; padding-bottom: 21px; }
.citizen-hero::after { position: absolute; inset: auto -120px -230px auto; width: 560px; height: 560px; border: 1px solid rgba(255,255,255,.15); border-radius: 50%; content: ''; pointer-events: none; }
.citizen-hero-phan-anh { background: linear-gradient(170deg, rgba(10,22,48,.92) 0%, rgba(18,45,78,.72) 38%, rgba(10,30,56,.92) 100%), url('https://images.unsplash.com/photo-1553877522-43269d4ea984?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat; }
.citizen-hero-thu-tuc { background: linear-gradient(170deg, rgba(10,22,48,.92) 0%, rgba(15,40,70,.72) 38%, rgba(10,30,56,.92) 100%), url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat; }
.hero-controls { position: absolute; right: 0; bottom: -9px; display: flex; align-items: center; gap: 9px; color: #dbeafe; font-size: 12px; }
.hero-controls button { width: 35px; height: 35px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.38); border-radius: 50%; color: #fff; background: rgba(255,255,255,.12); cursor: pointer; }
.hero-controls button:hover { background: rgba(255,255,255,.24); }
.hero-indicators { display: flex; gap: 7px; padding-bottom: 21px; }
.hero-indicators button { width: 25px; height: 4px; padding: 0; border: 0; border-radius: 99px; background: rgba(255,255,255,.35); cursor: pointer; }
.hero-indicators button.active { width: 43px; background: #fff; }
.citizen-hero-grid { min-height: 518px; display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 64px; padding: 68px 0; }
.citizen-eyebrow { color: var(--citizen-blue); font-size: 12px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; margin: 0 0 12px; }
.citizen-eyebrow-light { color: var(--citizen-blue-soft); }
.citizen-hero h1 { max-width: 620px; color: #fff; font-size: clamp(38px, 5.2vw, 68px); line-height: 1.08; letter-spacing: -.06em; margin: 0; font-weight: 800; }
.citizen-hero h1 em { font-style: normal; color: #60A5FA; font-weight: 800; }
.hero-accent-line { width: 48px; height: 3px; border-radius: 2px; background: #60A5FA; margin-bottom: 20px; opacity: .8; }
.hero-eyebrow-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #60A5FA; vertical-align: middle; margin-right: 2px; animation: heroDotPulse 2s ease-in-out infinite; }
@keyframes heroDotPulse { 0%, 100% { opacity: .6; transform: scale(1); } 50% { opacity: 1; transform: scale(1.4); } }
.hero-desc { max-width: 530px; color: rgba(255,255,255,.65); font-size: 16px; line-height: 1.7; margin: 22px 0 28px; }
.citizen-hero-actions, .success-actions, .contact-banner-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 11px; }
.citizen-button { min-height: 46px; display: inline-flex; justify-content: center; align-items: center; gap: 8px; border: 1px solid transparent; border-radius: 10px; padding: 10px 17px; font: inherit; font-size: 14px; font-weight: 700; text-decoration: none; cursor: pointer; transition: transform .18s ease, background .18s ease, box-shadow .18s ease; }
.citizen-button:hover { transform: translateY(-1px); }
.citizen-button-primary { color: #fff; background: var(--citizen-blue); box-shadow: 0 8px 18px rgba(18,97,160,.16); }
.citizen-button-primary:hover { background: var(--citizen-blue-dark); }
.citizen-button-white { color: var(--citizen-blue-dark); background: #fff; }
.citizen-button-white:hover { box-shadow: 0 7px 18px rgba(0,0,0,.13); }
.citizen-button-ghost { color: #fff; border-color: rgba(255,255,255,.5); background: rgba(255,255,255,.08); }
.citizen-button-ghost:hover { background: rgba(255,255,255,.16); }
.citizen-button-secondary { color: var(--citizen-blue-dark); border-color: var(--citizen-blue); background: #fff; }
.citizen-button-secondary:hover { background: var(--citizen-blue-soft); }
.full-width { width: 100%; }
.citizen-trust-note { display: inline-flex; align-items: center; gap: 8px; color: #d8edf1; font-size: 12px; margin-top: 30px; }
.citizen-hero-visual { min-height: 330px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28px; }
.hero-stat-card { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 36px 40px 30px; border-radius: 24px; background: rgba(255,255,255,.10); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,.18); text-align: center; }
.hero-stat-ring { position: relative; width: 130px; height: 130px; display: grid; place-items: center; }
.hero-ring-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.hero-ring-fill { transition: stroke-dasharray .8s cubic-bezier(.4,0,.2,1); }
.hero-ring-center { display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 1; }
.hero-ring-center strong { font-size: 38px; font-weight: 700; letter-spacing: -.05em; line-height: 1; }
.hero-ring-center span { color: rgba(255,255,255,.65); font-size: 11px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; margin-top: 3px; }
.hero-stat-label { max-width: 220px; color: rgba(255,255,255,.75); font-size: 13px; line-height: 1.55; margin: 0; }
.hero-stat-badge { display: inline-flex; align-items: center; gap: 7px; padding: 7px 14px; border-radius: 99px; color: #fff; background: rgba(255,255,255,.15); font-size: 12px; font-weight: 600; }

/* ─── Banner Visual (cho banner có ảnh) ─── */
.hero-banner-visual { position: relative; width: 100%; max-width: 440px; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 50px rgba(17,24,39,.25); }
.hero-banner-img { width: 100%; height: 290px; object-fit: cover; display: block; }
.hero-banner-overlay { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: 30px 28px; background: linear-gradient(0deg, rgba(10,22,48,.75) 0%, rgba(10,22,48,.20) 50%, transparent 75%); }
.hero-big-number { margin-bottom: 14px; }
.hero-big-number strong { display: block; font-size: 56px; font-weight: 700; letter-spacing: -.06em; line-height: 1; }
.hero-big-number span { display: block; color: rgba(255,255,255,.70); font-size: 13px; line-height: 1.5; margin-top: 6px; }
.hero-banner-badge { display: inline-flex; align-items: center; gap: 7px; padding: 7px 14px; border-radius: 99px; color: #fff; background: rgba(255,255,255,.15); font-size: 12px; font-weight: 600; width: fit-content; }
.citizen-quick-search { padding: 22px 0; border-bottom: 1px solid var(--citizen-line); background: #fff; }.citizen-quick-search .citizen-container { display: grid; grid-template-columns: 215px 1fr; align-items: center; gap: 25px; }.quick-search-label span, .quick-search-label small { display: block; }.quick-search-label span { color: var(--citizen-ink); font-weight: 800; }.quick-search-label small { color: var(--citizen-muted); font-size: 11px; line-height: 1.45; margin-top: 3px; }
.citizen-search { min-height: 52px; display: flex; align-items: center; gap: 12px; padding: 5px 6px 5px 17px; border: 1px solid #c6d7e5; border-radius: 12px; background: #fff; box-shadow: 0 7px 22px rgba(28,74,110,.07); }.citizen-search > svg { flex: 0 0 auto; color: #7990a2; }.citizen-search input { width: 100%; min-width: 0; border: 0; outline: 0; color: var(--citizen-ink); font: inherit; font-size: 14px; background: transparent; }.citizen-search input::placeholder { color: #8da0af; }
.citizen-section { padding: 84px 0; }.citizen-section-soft { background: var(--citizen-soft); }.citizen-section-heading { display: flex; justify-content: space-between; align-items: end; gap: 25px; margin-bottom: 31px; }.citizen-section-heading h2 { margin: 0; font-size: clamp(26px, 3vw, 36px); line-height: 1.2; letter-spacing: -.045em; }.citizen-section-heading > div > p:last-child { max-width: 620px; color: var(--citizen-muted); margin: 10px 0 0; }.citizen-text-link, .citizen-card-link, .back-link { display: inline-flex; align-items: center; gap: 7px; color: var(--citizen-blue); font-size: 13px; font-weight: 800; text-decoration: none; }.citizen-text-link:hover, .back-link:hover { color: var(--citizen-blue-dark); }
.citizen-feature-grid { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 15px; }.citizen-feature-card { position: relative; min-height: 255px; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; padding: 25px; border: 1px solid var(--citizen-line); border-radius: var(--citizen-radius); color: var(--citizen-ink); text-decoration: none; background: #fff; transition: transform .2s ease, box-shadow .2s ease; }.citizen-feature-card:hover, .citizen-card:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(26,70,105,.1); }.citizen-feature-card.feature-primary { color: #fff; border-color: #1261a0; background: linear-gradient(135deg, #1261a0, #177e99); }.citizen-feature-card > svg { position: absolute; right: -2px; bottom: 12px; color: rgba(255,255,255,.16); }.citizen-feature-card:not(.feature-primary) > svg { color: #dcecf5; }.feature-number { color: #80bce0; font-size: 12px; font-weight: 800; letter-spacing: .1em; }.citizen-feature-card h3 { margin: 16px 0 7px; font-size: 21px; letter-spacing: -.03em; }.citizen-feature-card p { max-width: 250px; color: #6a7f90; font-size: 13px; margin: 0 0 16px; }.feature-primary p { color: #d0e8f5; }.feature-primary .citizen-card-link { color: #fff; }
.procedure-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.news-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 15px; }
.news-grid > .news-card-v2:not(.news-featured) { display: grid; grid-template-columns: 130px 1fr; }
.news-grid > .news-card-v2:not(.news-featured) .nc-img-wrap { height: 100%; min-height: 130px; }
.news-grid > .news-featured { grid-row: span 2; }
.news-grid-list { grid-template-columns: repeat(3, 1fr); }
.news-grid-list > .news-featured { grid-row: auto; }
.news-grid-list > .news-card-v2:not(.news-featured) { display: flex; }
.citizen-process-section { background: #f6fbfc; border-top: 1px solid #e2eff0; }.process-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }.process-step { position: relative; }.process-step-number { color: #b0c3cf; font-size: 12px; font-weight: 800; }.process-step-icon { width: 49px; height: 49px; display: grid; place-items: center; color: var(--citizen-blue); border-radius: 50%; background: #dff2f2; margin: 13px 0 17px; }.process-step h3 { font-size: 16px; margin: 0 0 5px; }.process-step p { color: var(--citizen-muted); font-size: 13px; max-width: 220px; margin: 0; }.process-connector { position: absolute; top: 60px; left: 62px; right: -4px; border-top: 1px dashed #a9c5ce; }
.citizen-footer { color: #B0C4D9; background: #0A1628; margin-top: 0; }
.citizen-footer a { text-decoration: none; }

/* ─── Footer CTA ─── */
.footer-cta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 36px;
  padding: 48px 0;
  border-bottom: 1px solid rgba(255,255,255,.08);
}
.footer-cta-eyebrow {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: #60A5FA;
  margin: 0 0 6px;
}
.footer-cta-text h2 {
  margin: 0 0 8px;
  color: #fff;
  font-size: clamp(22px, 2.5vw, 30px);
  font-weight: 700;
  letter-spacing: -.03em;
}
.footer-cta-text span {
  color: rgba(255,255,255,.45);
  font-size: 14px;
  line-height: 1.6;
}
.footer-cta-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  flex: 0 0 auto;
}

/* ─── Footer Main Grid ─── */
.footer-main {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr;
  gap: 48px;
  padding: 48px 0;
}
.footer-logo {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: #fff;
  text-decoration: none;
  margin-bottom: 16px;
}
.footer-logo-icon {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  color: #fff;
  background: var(--citizen-blue);
}
.footer-logo strong, .footer-logo small { display: block; line-height: 1.25; }
.footer-logo strong { font-size: 15px; font-weight: 700; letter-spacing: -.02em; }
.footer-logo small { color: #7B8FA5; font-size: 11px; margin-top: 2px; }
.footer-brand > p {
  max-width: 280px;
  color: #7B8FA5;
  font-size: 13px;
  line-height: 1.7;
  margin: 0;
}

.footer-links h3, .footer-contact h3 {
  color: #fff;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .03em;
  margin: 0 0 18px;
  text-transform: uppercase;
}
.footer-links a {
  display: block;
  color: #7B8FA5;
  font-size: 13px;
  padding: 6px 0;
  transition: all .2s ease;
}
.footer-links a:hover { color: #fff; transform: translateX(3px); }

.footer-contact-item {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #7B8FA5;
  font-size: 13px;
  padding: 7px 0;
  line-height: 1.5;
}
.footer-contact a.footer-contact-item:hover { color: #fff; }

/* ─── Footer Bottom ─── */
.footer-bottom {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 18px 0;
  border-top: 1px solid rgba(255,255,255,.08);
  font-size: 12px;
  color: #5A7088;
}
.citizen-page-hero { padding: 69px 0 63px; color: #fff; background: linear-gradient(116deg, var(--citizen-blue-dark), var(--citizen-blue) 62%, var(--citizen-blue-dark)); }.citizen-page-hero h1 { max-width: 800px; font-size: clamp(34px, 5vw, 55px); line-height: 1.13; letter-spacing: -.055em; margin: 0; }.citizen-page-hero-description { max-width: 650px; color: var(--citizen-blue-soft); font-size: 16px; margin: 17px 0 0; }.page-hero-search { max-width: 720px; margin-top: 30px; }.page-hero-search .citizen-search { box-shadow: 0 15px 30px rgba(21,101,192,.18); }.article-date { display: inline-flex; align-items: center; gap: 7px; color: var(--citizen-blue-soft); font-size: 13px; margin-top: 22px; }
.listing-toolbar { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 29px; }.listing-toolbar h2 { font-size: 24px; letter-spacing: -.04em; margin: 0; }.listing-toolbar select, .category-tabs button { border: 1px solid #c9d9e4; border-radius: 9px; color: #536b7b; background: #fff; font: inherit; font-size: 13px; }.listing-toolbar select { min-width: 205px; padding: 12px 14px; }.category-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 29px; }.category-tabs button { padding: 10px 14px; cursor: pointer; }.category-tabs button.active, .category-tabs button:hover { color: #fff; border-color: var(--citizen-blue); background: var(--citizen-blue); }.citizen-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 270px; padding: 30px; border: 1px dashed #cbdce6; border-radius: var(--citizen-radius); color: #8499a8; text-align: center; background: #f9fbfc; }.citizen-empty h3 { color: var(--citizen-ink); margin: 12px 0 4px; }.citizen-empty p { max-width: 380px; margin: 0; font-size: 13px; }.citizen-error svg { color: #c4873b; }.citizen-loading { display: flex; justify-content: center; gap: 7px; padding: 40px; }.citizen-loading span { width: 9px; height: 9px; border-radius: 50%; background: var(--citizen-blue); animation: citizen-pulse 1s infinite ease-in-out; }.citizen-loading span:nth-child(2) { animation-delay: .16s; }.citizen-loading span:nth-child(3) { animation-delay: .32s; } @keyframes citizen-pulse { 0%, 80%, 100% { opacity: .3; transform: scale(.8); } 40% { opacity: 1; transform: scale(1); } }
.detail-layout, .article-layout, .form-layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 50px; }.back-link { margin-bottom: 27px; }.detail-main, .article-content { min-width: 0; }.detail-section { padding: 29px 0; border-top: 1px solid var(--citizen-line); }.detail-section h2 { font-size: 22px; margin: 0 0 22px; }.detail-steps > div { display: grid; grid-template-columns: 37px 1fr; align-items: center; gap: 13px; margin: 13px 0; }.detail-steps span { display: grid; place-items: center; width: 31px; height: 31px; border-radius: 50%; color: #fff; font-size: 12px; font-weight: 800; background: var(--citizen-blue); }.detail-steps p { margin: 0; }.document-list { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }.document-list li { display: flex; align-items: flex-start; gap: 10px; color: #536978; }.document-list svg { flex: 0 0 auto; color: #1d9b8e; margin-top: 4px; }.detail-summary { padding: 25px; border: 1px solid #cfe0ea; border-radius: var(--citizen-radius); background: #f5fafc; }.detail-summary > div { display: flex; gap: 11px; padding: 17px 0; border-top: 1px solid #dae7ee; }.detail-summary > div svg { color: var(--citizen-blue); margin-top: 4px; }.detail-summary small, .detail-summary strong { display: block; }.detail-summary small { color: var(--citizen-muted); font-size: 11px; }.detail-summary strong { margin-top: 3px; font-size: 14px; }.help-card { padding: 22px; margin-top: 16px; border-radius: var(--citizen-radius); background: #e8f6f5; }.help-card svg { color: #168c83; }.help-card strong { display: block; margin: 12px 0 4px; }.help-card p { color: #597b7c; font-size: 13px; margin: 0 0 10px; }.help-card a { color: #157d76; font-size: 14px; font-weight: 800; }
.article-image { width: 100%; max-height: 420px; object-fit: cover; border-radius: var(--citizen-radius); margin-bottom: 28px; }.article-content > p { color: #4e6474; font-size: 16px; line-height: 1.9; }.article-callout { display: flex; gap: 11px; margin-top: 25px; padding: 18px; border-left: 3px solid #1a9a90; color: #39706e; background: #eaf8f7; }.article-callout svg { flex: 0 0 auto; }.article-aside { padding-left: 24px; border-left: 1px solid var(--citizen-line); }.article-aside > a { position: relative; display: block; padding: 16px 25px 16px 0; border-top: 1px solid var(--citizen-line); color: var(--citizen-ink); text-decoration: none; }.article-aside > a span, .article-aside > a strong { display: block; }.article-aside > a span { color: var(--citizen-blue); font-size: 11px; font-weight: 800; }.article-aside > a strong { font-size: 14px; line-height: 1.45; margin-top: 5px; }.article-aside > a svg { position: absolute; right: 0; top: 45%; color: #8da2b1; }
.form-layout { align-items: start; }.complaint-form { padding: 34px; border: 1px solid var(--citizen-line); border-radius: var(--citizen-radius); box-shadow: 0 14px 35px rgba(25,73,106,.06); }.form-section-title { display: flex; gap: 13px; align-items: flex-start; padding-bottom: 23px; margin-bottom: 23px; border-bottom: 1px solid #e3edf2; }.form-section-title + .form-grid, .form-section-title + .form-field { margin-bottom: 34px; }.form-section-title > span { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px; color: var(--citizen-blue); font-size: 12px; font-weight: 800; background: #eaf3fa; }.form-section-title h2 { font-size: 20px; margin: 0; }.form-section-title p { color: var(--citizen-muted); font-size: 12px; margin: 2px 0 0; }.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }.form-field { display: flex; flex-direction: column; gap: 7px; margin-bottom: 18px; }.form-field > span { color: #385466; font-size: 13px; font-weight: 700; }.form-field b { color: #cb5c4f; }.form-field input, .form-field textarea, .form-field select { width: 100%; min-height: 47px; padding: 11px 13px; border: 1px solid #c7d8e3; border-radius: 9px; outline: 0; color: var(--citizen-ink); font: inherit; font-size: 13px; background: #fff; }.form-field textarea { min-height: 122px; resize: vertical; }.form-field input:focus, .form-field textarea:focus, .form-field select:focus { border-color: var(--citizen-blue); box-shadow: 0 0 0 3px rgba(18,97,160,.12); }.form-field .has-error { border-color: #c85b52; }.field-error { color: #b14840; font-size: 11px; }.upload-box { display: flex; align-items: center; gap: 13px; padding: 18px; margin: 6px 0 21px; border: 1px dashed #b5cfdf; border-radius: 11px; color: var(--citizen-blue); background: #f7fbfd; }.upload-box > div { flex: 1; }.upload-box strong, .upload-box p { display: block; }.upload-box strong { color: var(--citizen-ink); font-size: 13px; }.upload-box p { color: var(--citizen-muted); font-size: 11px; margin: 2px 0 0; }.upload-box small { color: #268e83; font-size: 11px; }.consent-row { display: flex; gap: 9px; align-items: flex-start; color: #607685; font-size: 12px; }.consent-row input { width: 16px; height: 16px; accent-color: var(--citizen-blue); margin-top: 3px; }.form-submit { margin-top: 25px; min-width: 170px; }.form-assurance { display: flex; gap: 10px; padding: 16px; margin-top: 15px; border-radius: 11px; color: #42706e; font-size: 12px; background: #e8f6f5; }.form-assurance svg { flex: 0 0 auto; }
.tracking-section { max-width: 820px; }.tracking-empty { padding: 35px 20px; text-align: center; }.tracking-empty > div { width: 65px; height: 65px; display: grid; place-items: center; color: var(--citizen-blue); border-radius: 20px; background: #eaf3fa; margin: 0 auto 16px; }.tracking-empty h2 { font-size: 23px; margin: 0 0 7px; }.tracking-empty p { color: var(--citizen-muted); max-width: 450px; margin: 0 auto; }.tracking-result { padding: 30px; border: 1px solid var(--citizen-line); border-radius: var(--citizen-radius); box-shadow: 0 14px 35px rgba(25,73,106,.06); }.tracking-result-header { display: flex; justify-content: space-between; gap: 18px; align-items: start; padding-bottom: 23px; border-bottom: 1px solid #e1ebf0; }.tracking-result-header h2 { font-size: 26px; margin: 0; }.tracking-result-header p:last-child { color: #536b7c; margin: 4px 0 0; }.citizen-status { display: inline-flex; align-items: center; padding: 6px 10px; border-radius: 99px; font-size: 11px; font-weight: 800; white-space: nowrap; }.citizen-status-info { color: #1765a0; background: #e4f0fa; }.citizen-status-success { color: #187c70; background: #ddf4ef; }.citizen-status-neutral { color: #687a86; background: #edf2f4; }.tracking-info-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; padding: 23px 0; }.tracking-info-grid > div { display: flex; gap: 9px; }.tracking-info-grid svg { flex: 0 0 auto; color: var(--citizen-blue); }.tracking-info-grid small, .tracking-info-grid strong { display: block; }.tracking-info-grid small { color: var(--citizen-muted); font-size: 11px; }.tracking-info-grid strong { font-size: 13px; line-height: 1.4; margin-top: 3px; }.tracking-timeline { padding-top: 25px; border-top: 1px solid #e1ebf0; }.tracking-timeline h3 { font-size: 18px; margin: 0 0 24px; }.tracking-step { position: relative; display: flex; gap: 16px; min-height: 66px; padding-left: 8px; }.tracking-step:not(:last-child)::after { position: absolute; content: ''; top: 21px; left: 16px; height: 45px; border-left: 1px dashed #c8d6de; }.tracking-dot { z-index: 1; width: 18px; height: 18px; display: grid; place-items: center; border: 2px solid #cbd8df; border-radius: 50%; color: #fff; background: #fff; }.tracking-step.done .tracking-dot { border-color: #1d998e; background: #1d998e; }.tracking-step strong, .tracking-step small { display: block; }.tracking-step strong { font-size: 13px; }.tracking-step small { color: var(--citizen-muted); font-size: 11px; margin-top: 2px; }
.contact-info-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }.contact-info-card { min-height: 155px; display: flex; flex-direction: column; gap: 17px; padding: 22px; border: 1px solid var(--citizen-line); border-radius: var(--citizen-radius); color: var(--citizen-ink); text-decoration: none; background: #fff; }.contact-info-card:hover { border-color: #9fc3dc; box-shadow: 0 10px 24px rgba(25,73,106,.06); }.contact-info-card > svg { color: var(--citizen-blue); }.contact-info-card small, .contact-info-card strong { display: block; }.contact-info-card small { color: var(--citizen-muted); font-size: 11px; }.contact-info-card strong { font-size: 14px; line-height: 1.5; margin-top: 4px; }.contact-lower { display: grid; grid-template-columns: .8fr 1.2fr; gap: 50px; margin-top: 62px; }.contact-map { min-height: 390px; display: flex; flex-direction: column; justify-content: end; padding: 25px; border-radius: var(--citizen-radius); color: #fff; background: linear-gradient(140deg, rgba(17,87,121,.72), rgba(20,133,135,.72)), repeating-linear-gradient(35deg, transparent, transparent 24px, rgba(255,255,255,.07) 25px, rgba(255,255,255,.07) 26px); }.contact-map svg { margin-bottom: auto; }.contact-map strong { font-size: 19px; }.contact-map p { color: #d7edf0; font-size: 13px; margin: 5px 0 13px; }.contact-map span { color: #a9d9dd; font-size: 11px; }.departments h2 { font-size: 27px; letter-spacing: -.045em; margin: 0 0 21px; }.department-row { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 17px 0; border-top: 1px solid var(--citizen-line); }.department-row strong { font-size: 14px; }.department-row p { color: var(--citizen-muted); font-size: 12px; margin: 2px 0 0; }.department-row a { color: var(--citizen-blue); font-size: 12px; font-weight: 800; white-space: nowrap; }
.success-page { min-height: 560px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }.success-icon { width: 83px; height: 83px; display: grid; place-items: center; color: #188c80; border-radius: 26px; background: #e2f6f3; margin-bottom: 22px; }.success-page h1 { font-size: 35px; letter-spacing: -.055em; margin: 0; }.success-page > p:not(.citizen-eyebrow) { color: var(--citizen-muted); margin: 12px 0 5px; }.complaint-code { color: var(--citizen-blue); font-size: 29px; letter-spacing: .08em; }.success-note { max-width: 500px; font-size: 13px; }.success-actions { margin-top: 23px; }.not-found-number { color: #c8e1ed; font-size: 120px; line-height: 1; font-weight: 800; letter-spacing: -.1em; }
@media (max-width: 900px) { .citizen-header-inner { min-height: 69px; }.citizen-menu-toggle { display: block; }.citizen-nav { display: none; position: absolute; top: 69px; left: 0; right: 0; flex-direction: column; align-items: stretch; padding: 13px 20px 20px; border-bottom: 1px solid var(--citizen-line); background: #fff; box-shadow: 0 15px 25px rgba(18,65,98,.1); }.citizen-nav-open { display: flex; }.citizen-nav a, .citizen-officer-link { margin: 0; }.citizen-officer-link { justify-content: center; margin-top: 6px; }.citizen-hero-grid { grid-template-columns: 1fr .8fr; gap: 25px; }.citizen-feature-grid { grid-template-columns: 1fr 1fr; }.citizen-feature-card.feature-primary { grid-column: span 2; }.procedure-grid, .news-grid-list { grid-template-columns: repeat(2, 1fr); }.detail-layout, .article-layout, .form-layout { gap: 28px; }.contact-info-grid { grid-template-columns: repeat(2, 1fr); }.contact-lower { gap: 28px; } }
@media (max-width: 680px) { .citizen-container { width: min(100% - 28px, 560px); }.citizen-topbar-inner { min-height: 32px; }.citizen-topbar-inner span { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.citizen-topbar-inner a { display: none; }.citizen-brand strong { font-size: 14px; }.citizen-brand small { font-size: 10px; }.citizen-hero-grid { display: block; padding: 48px 0 34px; }.citizen-hero h1 { font-size: 43px; }.hero-desc { font-size: 15px; }.citizen-hero-visual { min-height: 255px; margin-top: 25px; }.hero-stat-card { padding: 28px 24px 22px; }.hero-stat-ring { width: 110px; height: 110px; }.hero-ring-center strong { font-size: 32px; }.citizen-quick-search .citizen-container { display: block; }.quick-search-label { margin-bottom: 12px; }.citizen-search { padding-left: 13px; }.citizen-search .citizen-button { min-height: 39px; padding: 7px 11px; font-size: 12px; }.citizen-section { padding: 58px 0; }.citizen-section-heading { display: block; margin-bottom: 24px; }.citizen-section-heading .citizen-text-link { margin-top: 14px; }.citizen-feature-grid, .procedure-grid, .news-grid, .news-grid-list, .contact-info-grid, .contact-lower, .detail-layout, .article-layout, .form-layout { grid-template-columns: 1fr; }.citizen-feature-card.feature-primary { grid-column: auto; }.citizen-feature-card { min-height: 220px; }.news-grid > .citizen-news-card:not(:first-child) { display: flex; }.citizen-news-card:first-child { grid-row: auto; }.process-steps { grid-template-columns: 1fr 1fr; gap: 24px 17px; }.process-connector { display: none; }.citizen-page-hero { padding: 48px 0 44px; }.citizen-page-hero h1 { font-size: 39px; }.listing-toolbar { display: block; }.listing-toolbar select { width: 100%; margin-top: 17px; }.form-layout { display: block; }.complaint-form { padding: 20px 16px; }.form-grid, .tracking-info-grid { grid-template-columns: 1fr; }.form-section-title h2 { font-size: 18px; }.upload-box { flex-wrap: wrap; }.upload-box > div { min-width: calc(100% - 45px); }.upload-box label { margin-left: 35px; }.detail-aside, .article-aside { border-left: 0; padding-left: 0; }.tracking-result { padding: 20px 16px; }.tracking-result-header { display: block; }.tracking-result-header .citizen-status { margin-top: 15px; }.success-page h1 { font-size: 28px; }.not-found-number { font-size: 84px; } }
@media (prefers-reduced-motion: reduce) { .citizen-button, .citizen-feature-card, .citizen-card, .citizen-news-card { transition: none; } .citizen-loading span { animation: none; } }

/* Bảng màu lấy từ ứng dụng mobile: chỉ sử dụng xanh nhận diện và các sắc độ xanh nhạt. */
.citizen-section { padding: var(--citizen-section-space) 0; }.citizen-section-heading { gap: var(--citizen-space); margin-bottom: 32px; }.citizen-feature-grid, .procedure-grid, .news-grid, .process-steps, .contact-info-grid, .citizen-mobile-feature-grid, .citizen-service-grid, .citizen-notice-layout, .citizen-schedule-layout, .citizen-guide-steps { gap: var(--citizen-gap); }
.citizen-card, .citizen-feature-card, .citizen-mobile-feature, .citizen-service-card, .citizen-notice-card, .citizen-schedule-row, .citizen-guide-steps > div { padding: var(--citizen-space); }.citizen-emergency-card, .citizen-schedule-aside, .citizen-guidance-panel { padding: calc(var(--citizen-space) + 8px); }
.citizen-hero-grid { padding: var(--citizen-section-space) 0; }
.citizen-hero-grid { height: 500px; min-height: 500px; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; }.citizen-hero-copy { display: flex; min-height: 100%; flex-direction: column; justify-content: center; }.citizen-hero-copy h1 { max-width: 590px; min-height: 3.24em; font-size: clamp(36px, 4vw, 56px); }.hero-desc { min-height: 80px; margin: 20px 0 24px; }.citizen-hero-actions { min-height: 46px; }.citizen-trust-note { min-height: 20px; margin-top: 24px; }.citizen-hero-visual { min-height: 300px; }
.citizen-footer { color: #B0C4D9; background: #0A1628; margin-top: 0; }
.citizen-feature-card.feature-primary { border-color: var(--citizen-blue-dark); background: linear-gradient(135deg, var(--citizen-blue-dark), var(--citizen-blue)); }
.citizen-feature-card:not(.feature-primary) > svg, .feature-number { color: var(--citizen-blue); }
.feature-primary p { color: var(--citizen-blue-soft); }
.procedure-card-icon, .form-section-title > span, .tracking-empty > div { color: var(--citizen-blue-dark); background: var(--citizen-blue-soft); }
.citizen-process-section { background: var(--citizen-soft); border-color: var(--citizen-line); }
.process-step-number { color: var(--citizen-blue); }.process-step-icon { color: var(--citizen-blue-dark); background: var(--citizen-blue-soft); }.process-connector { border-color: var(--citizen-blue); }
.contact-map { background: linear-gradient(135deg, var(--citizen-blue-dark), var(--citizen-blue)); }
.help-card, .form-assurance, .article-callout { color: var(--citizen-blue-dark); background: var(--citizen-blue-soft); }.help-card svg, .help-card a, .article-callout svg { color: var(--citizen-blue-dark); }.article-callout { border-left-color: var(--citizen-blue); }
.citizen-status-info, .citizen-status-success { color: var(--citizen-blue-dark); background: var(--citizen-blue-soft); }.tracking-step.done .tracking-dot { border-color: var(--citizen-blue); background: var(--citizen-blue); }
.citizen-mobile-feature-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; }.citizen-mobile-feature { min-height: 190px; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 20px; border: 1px solid var(--citizen-line); border-radius: var(--citizen-radius); color: var(--citizen-ink); text-decoration: none; background: #fff; transition: transform .18s ease, box-shadow .18s ease; }.citizen-mobile-feature:hover { transform: translateY(-3px); box-shadow: 0 14px 28px rgba(21,101,192,.12); }.citizen-mobile-feature-icon { display: grid; place-items: center; width: 50px; height: 50px; border-radius: 15px; color: var(--citizen-blue-dark); background: var(--citizen-blue-soft); }.citizen-mobile-feature strong { font-size: 15px; line-height: 1.35; }.citizen-mobile-feature small { color: var(--citizen-muted); font-size: 12px; line-height: 1.55; }
.citizen-notice-layout { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(320px, .55fr); align-items: stretch; gap: 26px; }.citizen-notice-list { display: grid; gap: 12px; }.citizen-notice-card { display: block; padding: 18px 20px; border: 1px solid var(--citizen-line); border-radius: 13px; color: var(--citizen-ink); text-decoration: none; background: #fff; }.citizen-notice-card:hover { border-color: var(--citizen-blue); }.citizen-notice-card > div { display: flex; gap: 7px; margin-bottom: 9px; }.citizen-notice-card strong, .citizen-notice-card time { display: block; }.citizen-notice-card strong { font-size: 15px; }.citizen-notice-card time { color: var(--citizen-muted); font-size: 12px; margin-top: 6px; }.citizen-notice-tag { display: inline-flex; padding: 3px 8px; border-radius: 6px; color: var(--citizen-blue-dark); background: var(--citizen-blue-soft); font-size: 11px; font-weight: 800; text-transform: uppercase; }.citizen-notice-tag.is-important { color: #E53935; background: #FFEBEE; }.citizen-notice-tag.is-new { color: var(--citizen-blue-dark); background: var(--citizen-blue-soft); }.citizen-emergency-card { display: flex; flex-direction: column; justify-content: center; padding: 30px; border-radius: var(--citizen-radius); color: #fff; background: linear-gradient(145deg, var(--citizen-blue-dark), var(--citizen-blue)); }.citizen-emergency-card h2 { font-size: 24px; margin: 17px 0 3px; }.citizen-emergency-card p { color: var(--citizen-blue-soft); margin: 0 0 22px; }.citizen-emergency-card > div { display: flex; flex-wrap: wrap; gap: 10px; }.citizen-button-danger { color: #fff; background: #E53935; }
.citizen-service-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }.citizen-service-card { min-height: 255px; display: flex; flex-direction: column; padding: 24px; border: 1px solid var(--citizen-line); border-radius: var(--citizen-radius); color: var(--citizen-ink); text-decoration: none; background: #fff; }.citizen-service-card:hover { border-color: var(--citizen-blue); box-shadow: 0 14px 28px rgba(21,101,192,.1); }.citizen-service-icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 15px; color: var(--citizen-blue-dark); background: var(--citizen-blue-soft); }.citizen-service-card h2 { font-size: 19px; margin: 20px 0 8px; }.citizen-service-card p { color: var(--citizen-muted); font-size: 13px; margin: 0; }.citizen-service-card .citizen-card-link { margin-top: auto; padding-top: 20px; }.citizen-guidance-panel { display: flex; justify-content: space-between; align-items: center; gap: 30px; padding: 40px; border: 1px solid var(--citizen-line); border-radius: var(--citizen-radius); background: var(--citizen-blue-soft); }.citizen-guidance-panel h2 { font-size: 26px; margin: 0 0 7px; }.citizen-guidance-panel p:not(.citizen-eyebrow) { max-width: 700px; color: var(--citizen-muted); margin: 0; }
.citizen-schedule-layout { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(300px, .5fr); gap: 30px; }.citizen-schedule-list { display: grid; gap: 12px; }.citizen-schedule-row { display: grid; grid-template-columns: 185px 1fr; gap: 22px; align-items: center; padding: 20px; border: 1px solid var(--citizen-line); border-radius: 13px; }.citizen-schedule-day { display: grid; grid-template-columns: 23px 1fr; align-items: center; gap: 4px 9px; color: var(--citizen-blue-dark); }.citizen-schedule-day svg { grid-row: span 2; }.citizen-schedule-day span { font-size: 12px; }.citizen-schedule-row > div:last-child > strong { font-size: 15px; }.citizen-schedule-row p { display: flex; align-items: center; gap: 6px; color: var(--citizen-muted); font-size: 12px; margin: 6px 0 0; }.citizen-schedule-aside { align-self: start; padding: 30px; border-radius: var(--citizen-radius); color: #fff; background: linear-gradient(145deg, var(--citizen-blue-dark), var(--citizen-blue)); }.citizen-schedule-aside h2 { font-size: 24px; margin: 18px 0 7px; }.citizen-schedule-aside p { color: var(--citizen-blue-soft); font-size: 13px; margin: 0 0 24px; }.citizen-schedule-aside .citizen-button { width: 100%; color: var(--citizen-blue-dark); background: #fff; }.citizen-guide-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }.citizen-guide-steps > div { padding: 24px; border: 1px solid var(--citizen-line); border-radius: var(--citizen-radius); background: #fff; }.citizen-guide-steps span { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; color: #fff; background: var(--citizen-blue); font-weight: 800; }.citizen-guide-steps h2 { font-size: 17px; line-height: 1.45; margin: 20px 0 0; }
@media (max-width: 1100px) { .citizen-mobile-feature-grid { grid-template-columns: repeat(3, 1fr); }.citizen-service-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 680px) { :root { --citizen-space: 16px; --citizen-gap: 14px; --citizen-section-space: 48px; }.citizen-mobile-feature-grid, .citizen-service-grid, .citizen-notice-layout, .citizen-schedule-layout, .citizen-guide-steps { grid-template-columns: 1fr; }.citizen-mobile-feature { min-height: 145px; }.citizen-guidance-panel { display: block; padding: var(--citizen-space); }.citizen-guidance-panel .citizen-button { width: 100%; margin-top: var(--citizen-space); }.citizen-schedule-row { grid-template-columns: 1fr; gap: var(--citizen-gap); }.citizen-container { width: min(100% - 28px, 760px); }.citizen-hero-grid { height: auto; min-height: 0; }.citizen-hero-copy { min-height: 0; }.citizen-hero-copy h1, .hero-desc { min-height: 0; } }

.procedure-list-layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 32px; }.procedure-filter { align-self: start; display: grid; gap: 7px; padding: 20px; border: 1px solid var(--citizen-line); border-radius: var(--citizen-radius); background: #fff; }.procedure-filter strong { margin-bottom: 6px; }.procedure-filter button { padding: 10px; border: 0; border-radius: 9px; color: var(--citizen-ink); background: transparent; font: inherit; text-align: left; cursor: pointer; }.procedure-filter button:hover, .procedure-filter button.active { color: var(--citizen-blue-dark); background: var(--citizen-blue-soft); }.citizen-sort { display: grid; gap: 5px; color: var(--citizen-muted); font-size: 12px; }.citizen-sort select { min-width: 190px; padding: 10px; border: 1px solid var(--citizen-line); border-radius: 9px; font: inherit; }.load-more { display: flex; justify-content: center; margin-top: 28px; }.detail-facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; overflow: hidden; border: 1px solid var(--citizen-line); border-radius: 12px; background: var(--citizen-line); }.detail-facts > div { padding: 17px; background: #fff; }.detail-facts small, .detail-facts strong { display: block; }.detail-facts small { color: var(--citizen-muted); font-size: 12px; }.detail-facts strong { margin-top: 5px; font-size: 14px; }.template-list { display: grid; gap: 10px; }.template-list button { display: flex; align-items: center; gap: 10px; padding: 14px; border: 1px solid var(--citizen-line); border-radius: 10px; color: var(--citizen-ink); background: #fff; font: inherit; text-align: left; }.template-list button span { margin-left: auto; color: var(--citizen-blue-dark); font-size: 12px; font-weight: 700; }.detail-summary { display: grid; gap: 10px; }.complaint-progress { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 28px; }.complaint-progress button { display: flex; align-items: center; gap: 7px; padding: 9px; border: 0; color: var(--citizen-muted); background: transparent; font: inherit; font-size: 12px; text-align: left; }.complaint-progress span { display: grid; place-items: center; flex: 0 0 auto; width: 25px; height: 25px; border: 1px solid var(--citizen-line); border-radius: 50%; background: #fff; }.complaint-progress .active, .complaint-progress .done { color: var(--citizen-blue-dark); font-weight: 700; }.complaint-progress .active span, .complaint-progress .done span { border-color: var(--citizen-blue); color: #fff; background: var(--citizen-blue); }.form-navigation { display: flex; justify-content: space-between; gap: 12px; margin-top: 28px; }.form-navigation .citizen-button:last-child { margin-left: auto; }.file-preview { display: flex; flex-wrap: wrap; gap: 8px; margin: -10px 0 18px; }.file-preview span { padding: 6px 9px; border-radius: 7px; color: var(--citizen-blue-dark); background: var(--citizen-blue-soft); font-size: 12px; }.review-box { display: grid; gap: 8px; padding: 18px; border-radius: 12px; background: var(--citizen-soft); }.review-box span { color: var(--citizen-blue-dark); font-size: 13px; font-weight: 700; }.review-box p, .review-box small { margin: 0; color: var(--citizen-muted); }.department-search { display: flex; align-items: center; gap: 8px; padding: 10px 12px; margin-bottom: 12px; border: 1px solid var(--citizen-line); border-radius: 10px; }.department-search input { width: 100%; border: 0; outline: 0; font: inherit; }.contact-map a { align-self: start; margin-top: 12px; text-decoration: none; }
@media (max-width: 780px) { .procedure-list-layout { grid-template-columns: 1fr; }.procedure-filter { grid-template-columns: repeat(2, 1fr); }.detail-facts, .complaint-progress { grid-template-columns: 1fr 1fr; }.complaint-progress { gap: 4px; }.complaint-progress button { font-size: 10px; }.citizen-sort { margin-top: 16px; } }

/* Lớp hoàn thiện UI: ít khung thừa, ưu tiên phân cấp và khả năng đọc cho dịch vụ công. */
.citizen-app { background: #fff; }.citizen-app main { overflow: hidden; }.citizen-header { box-shadow: 0 1px 0 rgba(21,101,192,.06); }.citizen-header-inner { max-width: 1440px; }.citizen-brand-mark { border-radius: 12px; box-shadow: none; }.citizen-nav { gap: 3px; }.citizen-nav a { padding: 10px 11px; }.citizen-nav a.active { box-shadow: inset 0 -2px 0 var(--citizen-blue); }.citizen-officer-link { min-height: 42px; border-radius: 10px; }
.citizen-hero { position: relative; }.citizen-hero::after { position: absolute; inset: auto -120px -230px auto; width: 560px; height: 560px; border: 1px solid rgba(255,255,255,.15); border-radius: 50%; content: ''; pointer-events: none; }.citizen-hero-copy { position: relative; z-index: 1; }.citizen-hero h1 { letter-spacing: -.052em; }.hero-desc { max-width: 570px; line-height: 1.7; }.hero-stat-card { border-radius: 20px; }.hero-controls button { transition: background .18s ease, transform .18s ease; }.hero-controls button:hover { transform: translateY(-1px); }
.citizen-quick-search { position: relative; z-index: 2; padding: 0; margin-top: -36px; border: 0; background: transparent; }
.citizen-quick-search .citizen-container { max-width: 780px; min-height: auto; padding: 32px 40px; border: 0; border-radius: 20px; background: #fff; box-shadow: 0 12px 48px rgba(10,30,56,.12); transform: none; animation: searchFloatUp .7s cubic-bezier(.16,1,.3,1) .3s both; }
.citizen-quick-search .citizen-container { grid-template-columns: 1fr; }
.quick-search-label { padding-right: 0; text-align: center; margin-bottom: 18px; }
.quick-search-label span { font-size: 20px; font-weight: 700; letter-spacing: -.03em; }
.quick-search-label small { font-size: 13px; }
.citizen-search { min-height: 54px; gap: 0; padding: 6px 6px 6px 22px; border: 2px solid #E2E8F0; border-radius: 60px; box-shadow: 0 2px 8px rgba(0,0,0,.02); transition: all .25s ease; background: #fff; }
.citizen-search:focus-within { border-color: var(--citizen-blue); box-shadow: 0 0 0 5px rgba(37,99,235,.06); }
.citizen-search > svg { flex: 0 0 auto; color: #94A3B8; }
.citizen-search input { padding: 12px 14px; font-size: 15px; }
.citizen-search input::placeholder { color: #B0B8C1; }
.citizen-search .citizen-button { min-height: 44px; min-width: 120px; padding: 0 24px; border-radius: 60px; }
.citizen-section-heading h2 { color: var(--citizen-ink); font-size: clamp(27px, 3vw, 38px); }.citizen-section-heading > div > p:last-child { font-size: 15px; line-height: 1.7; }.citizen-eyebrow { color: var(--citizen-blue-dark); letter-spacing: .09em; }
.citizen-section-tag { display: inline-block; padding: 5px 14px; border-radius: 7px; background: var(--citizen-blue-soft); color: var(--citizen-blue-dark); font-size: 11px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; margin-bottom: 14px; }
.section-tag-important { color: #E53935; background: #FFEBEE; }.citizen-card, .citizen-feature-card, .citizen-mobile-feature, .citizen-service-card, .citizen-news-card, .citizen-notice-card { border-color: var(--citizen-line); box-shadow: none; }.citizen-card:hover, .citizen-feature-card:hover, .citizen-mobile-feature:hover, .citizen-service-card:hover, .citizen-news-card:hover { border-color: rgba(37,99,235,.40); box-shadow: 0 16px 30px rgba(21,101,192,.10); }
.citizen-mobile-feature-grid { gap: 16px; }.citizen-mobile-feature { min-height: 168px; justify-content: flex-start; border-radius: 14px; }.citizen-mobile-feature:first-child { grid-column: span 2; background: linear-gradient(135deg, var(--citizen-blue-soft), #fff); }.citizen-mobile-feature:first-child .citizen-mobile-feature-icon { color: #fff; background: var(--citizen-blue); }.citizen-mobile-feature strong { font-size: 16px; }.citizen-mobile-feature small { max-width: 230px; }.citizen-notice-card { border-left: 3px solid var(--citizen-blue); }.citizen-emergency-card { border-radius: 14px; box-shadow: 0 16px 32px rgba(21,101,192,.15); }
.procedure-card-icon, .citizen-service-icon { border-radius: 12px; }.procedure-card-meta { color: var(--citizen-muted); }.citizen-news-card img { filter: saturate(.86); }.citizen-news-card-featured img { filter: saturate(1); }.process-step-icon { width: 52px; height: 52px; }.citizen-process-section { background: linear-gradient(180deg, var(--citizen-soft), #fff); }
.procedure-filter { position: sticky; top: 102px; border-radius: 14px; }.listing-toolbar { align-items: center; }.citizen-sort select, .listing-toolbar select { min-height: 44px; border-color: var(--citizen-line); }.detail-facts { border-radius: 14px; }.complaint-form, .tracking-result { border-radius: 16px; box-shadow: 0 16px 36px rgba(21,101,192,.08); }.complaint-progress { padding: 12px; border-radius: 12px; background: var(--citizen-soft); }.form-field input, .form-field textarea, .form-field select { min-height: 48px; border-radius: 10px; }.form-field input:focus, .form-field textarea:focus, .form-field select:focus { box-shadow: 0 0 0 3px rgba(37,99,235,.14); }.tracking-step { padding-bottom: 8px; }
.citizen-footer { margin-top: 0; }. } }.citizen-button:focus-visible, .citizen-nav a:focus-visible, .citizen-mobile-feature:focus-visible, .citizen-card:focus-visible, .citizen-news-card:focus-visible { outline: 3px solid rgba(227,242,253,.9); outline-offset: 3px; }.citizen-app main a:focus-visible, .citizen-app main button:focus-visible, .citizen-app main input:focus-visible, .citizen-app main select:focus-visible, .citizen-app main textarea:focus-visible { outline: 3px solid rgba(37,99,235,.30); outline-offset: 2px; }
@media (max-width: 1100px) { .citizen-mobile-feature:first-child { grid-column: span 2; } }
@media (max-width: 680px) { .citizen-quick-search { padding-top: 16px; }.citizen-quick-search .citizen-container { padding: 14px; transform: none; }.citizen-mobile-feature:first-child { grid-column: auto; }.citizen-hero::after { width: 340px; height: 340px; right: -140px; bottom: -160px; }.procedure-filter { position: static; }.citizen-section-heading h2 { font-size: 28px; }.citizen-mobile-feature { min-height: 138px; } }

/* Nhịp chữ và khoảng cách được cân lại cho Lexend. */
.citizen-brand strong { letter-spacing: -.01em; }.citizen-nav a, .citizen-officer-link { line-height: 1.4; }.citizen-hero h1, .citizen-page-hero h1, .citizen-section-heading h2 { letter-spacing: -.035em; line-height: 1.18; }.citizen-hero-copy h1 { min-height: 3.54em; }.hero-desc { min-height: 76px; margin: 18px 0 22px; line-height: 1.68; }.citizen-hero-actions { gap: 12px; }.citizen-trust-note { margin-top: 20px; }.citizen-section-heading { margin-bottom: 28px; }.citizen-section-heading > div > p:last-child { margin-top: 12px; }.citizen-card h3, .citizen-news-content h3, .citizen-mobile-feature strong, .citizen-service-card h2 { line-height: 1.45; }.citizen-card p, .citizen-news-content p, .citizen-mobile-feature small, .citizen-service-card p { line-height: 1.65; }.citizen-button { line-height: 1.35; }.form-field { gap: 8px; }.form-section-title { padding-bottom: 20px; margin-bottom: 24px; }. }
@media (max-width: 680px) { .citizen-hero h1 { line-height: 1.16; }.hero-desc { margin: 16px 0 20px; }.citizen-section-heading { margin-bottom: 22px; }.citizen-section-heading > div > p:last-child { margin-top: 10px; } }

/* Không để chữ Lexend rộng hơn làm các phần tử chồng lấn ở màn hình vừa. */
.citizen-hero-copy h1, .hero-desc, .citizen-hero-actions, .citizen-trust-note { min-height: 0; }.citizen-hero-copy { gap: 0; }.citizen-hero-copy .citizen-eyebrow { margin-bottom: 14px; }.citizen-hero h1 { margin-bottom: 0; }.hero-desc { margin: 18px 0 22px; }.citizen-hero-grid { align-items: center; }.citizen-hero-visual { width: 100%; }.citizen-section-heading, .listing-toolbar, . }.citizen-mobile-feature, .citizen-service-card, .citizen-card, .citizen-news-content, .contact-info-card { min-width: 0; }.citizen-mobile-feature strong, .citizen-service-card h2, .citizen-card h3, .citizen-news-content h3, .department-row strong { overflow-wrap: anywhere; }
@media (max-width: 1100px) { .citizen-header-inner { min-height: 70px; }.citizen-menu-toggle { display: block; }.citizen-nav { display: none; position: absolute; top: 70px; left: 0; right: 0; flex-direction: column; align-items: stretch; padding: 14px 32px 20px; border-bottom: 1px solid var(--citizen-line); background: #fff; box-shadow: 0 16px 30px rgba(21,101,192,.12); }.citizen-nav-open { display: flex; }.citizen-nav a, .citizen-officer-link { margin: 0; }.citizen-officer-link { justify-content: center; margin-top: 6px; }.citizen-hero-grid { height: auto; min-height: 500px; gap: 32px; }.citizen-hero-copy h1 { font-size: clamp(35px, 4.5vw, 50px); }.hero-desc { min-height: 0; }.citizen-notice-layout, .citizen-schedule-layout { grid-template-columns: 1fr; }.citizen-emergency-card, .citizen-schedule-aside { min-height: 0; } }
@media (max-width: 680px) { .citizen-nav { top: 69px; padding: 12px 14px 18px; }.citizen-hero-grid { min-height: 0; }.citizen-hero-copy .citizen-eyebrow { margin-bottom: 10px; }.citizen-hero-actions { align-items: stretch; }.citizen-hero-actions .citizen-button { flex: 1 1 100%; }.form-navigation { flex-wrap: wrap; }.form-navigation .citizen-button { flex: 1 1 100%; }.form-navigation .citizen-button:last-child { margin-left: 0; }.detail-facts > div, .contact-info-card, .department-row { min-width: 0; } }

/* Tách các khung nội dung rõ ràng, giữ cùng một nhịp khoảng cách. */
.citizen-feature-grid, .procedure-grid, .news-grid, .news-grid-list, .contact-info-grid, .citizen-mobile-feature-grid, .citizen-service-grid, .citizen-notice-layout, .citizen-schedule-layout, .citizen-guide-steps, .process-steps { gap: 20px; }.citizen-card, .citizen-feature-card, .citizen-mobile-feature, .citizen-service-card, .citizen-news-card, .citizen-notice-card, .contact-info-card { isolation: isolate; }.citizen-card, .citizen-feature-card, .citizen-mobile-feature, .citizen-service-card, .citizen-news-card, .citizen-notice-card { border-width: 1px; }
@media (max-width: 680px) { .citizen-feature-grid, .procedure-grid, .news-grid, .news-grid-list, .contact-info-grid, .citizen-mobile-feature-grid, .citizen-service-grid, .citizen-notice-layout, .citizen-schedule-layout, .citizen-guide-steps, .process-steps { gap: 16px; } }

/* Khối tìm kiếm nhanh: tách rõ nhãn, ô nhập và nút thao tác. */
.citizen-quick-search .citizen-container { grid-template-columns: minmax(230px, .55fr) minmax(0, 1.45fr); column-gap: 32px; row-gap: 16px; }.quick-search-label { min-width: 0; padding-right: 8px; }.quick-search-label span { margin-bottom: 4px; }.citizen-search { gap: 14px; padding: 6px 7px 6px 18px; }.citizen-search input { min-width: 0; padding: 5px 0; }.citizen-search .citizen-button { flex: 0 0 auto; min-width: 112px; }
@media (max-width: 820px) { .citizen-quick-search .citizen-container { grid-template-columns: 1fr; }.quick-search-label { padding-right: 0; }.citizen-search { width: 100%; } }
@media (max-width: 480px) { .citizen-search { flex-wrap: wrap; padding: 12px; }.citizen-search input { min-width: calc(100% - 40px); }.citizen-search .citizen-button { width: 100%; } }

/* =============================================
   THƯ VIỆN SỐ — Trang dành riêng cho người dân
   ============================================= */

/* ═══ HERO — Tiêu đề gọn ═══ */
.library-hero { position: relative; overflow: hidden; padding: 140px 0 120px; color: #fff; background: #1A1A1A; min-height: 85vh; display: flex; align-items: center; }
.library-hero-congan {
  background:
    linear-gradient(170deg, rgba(10,22,48,.88) 0%, rgba(15,40,70,.72) 38%, rgba(10,30,56,.90) 100%),
    url('https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
}
.library-hero-inner { position: relative; z-index: 4; max-width: 720px; margin: 0 auto; text-align: center; }
.library-hero::before { position: absolute; inset: 0; z-index: 2; content: ''; pointer-events: none; background: radial-gradient(ellipse at 50% 40%, rgba(212,168,83,.04) 0%, transparent 60%); }
.hero-overlay { display: none; }

.library-hero h1 { margin: 0 0 16px; font-size: clamp(34px, 4vw, 52px); font-weight: 700; letter-spacing: -.035em; line-height: 1.16; }
.library-hero h1 em { font-style: normal; }
.library-hero h1 em:first-of-type { color: #60A5FA; }
.library-hero h1 em:last-of-type { color: #93C5FD; }
.library-hero-sub { max-width: 580px; margin: 0 auto 32px; color: rgba(255,255,255,.50); font-size: 15px; line-height: 1.7; }

.hero-pillars { display: flex; align-items: center; justify-content: center; gap: 28px; }
.hero-pillar { display: flex; align-items: center; gap: 10px; text-align: left; }
.hero-pillar-icon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; }
.hero-pillar-library { background: rgba(37,99,235,.20); color: #60A5FA; border: 1px solid rgba(37,99,235,.30); }
.hero-pillar-police { background: rgba(37,99,235,.15); color: #93C5FD; border: 1px solid rgba(37,99,235,.25); }
.hero-pillar strong { display: block; font-size: 18px; font-weight: 700; letter-spacing: -.02em; color: #fff; }
.hero-pillar span { display: block; font-size: 11px; color: rgba(255,255,255,.40); margin-top: 1px; }
.hero-pillar-divider { width: 1px; height: 36px; background: rgba(255,255,255,.08); }

/* ═══ SEARCH SECTION ═══ */
.library-search-section { position: relative; z-index: 10; margin-top: -32px; padding: 0 0 32px; }
.lib-search-hero { max-width: 800px; margin: 0 auto; padding: 40px 48px; border-radius: 24px; background: #fff; box-shadow: 0 8px 40px rgba(21,101,192,.08); text-align: center; animation: searchFloatUp .7s cubic-bezier(.16,1,.3,1) .3s both; }
@keyframes searchFloatUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }
.lib-search-hero-text { margin-bottom: 26px; }
.lib-search-hero-text h2 { margin: 0 0 6px; font-size: clamp(22px, 2.5vw, 28px); font-weight: 700; letter-spacing: -.03em; color: var(--citizen-ink); }
.lib-search-hero-text p { margin: 0; color: var(--citizen-muted); font-size: 14px; }

.lib-search-bar { display: flex; align-items: center; gap: 0; padding: 5px 5px 5px 18px; border: 2px solid #E2E8F0; border-radius: 60px; background: #fff; transition: all .25s ease; box-shadow: 0 2px 8px rgba(0,0,0,.02); }
.lib-search-bar:focus-within { border-color: var(--citizen-blue); box-shadow: 0 0 0 5px rgba(37,99,235,.06); }
.lib-search-bar-icon { flex: 0 0 auto; color: #94A3B8; }
.lib-search-bar-input { flex: 1; min-width: 0; border: 0; outline: 0; padding: 12px 14px; font: inherit; font-size: 15px; color: var(--citizen-ink); background: transparent; }
.lib-search-bar-input::placeholder { color: #B0B8C1; }
.lib-search-bar-btn { display: inline-flex; align-items: center; gap: 6px; height: 46px; padding: 0 22px; border: 0; border-radius: 60px; color: #fff; background: var(--citizen-blue); font: inherit; font-size: 14px; font-weight: 700; cursor: pointer; transition: all .2s ease; white-space: nowrap; box-shadow: 0 4px 12px rgba(37,99,235,.18); }
.lib-search-bar-btn:hover { background: var(--citizen-blue-dark); box-shadow: 0 6px 18px rgba(37,99,235,.28); transform: translateY(-1px); }
.lib-search-law-btn { display: inline-flex; align-items: center; gap: 6px; height: 46px; padding: 0 18px; border: 1.5px solid #E2E8F0; border-radius: 60px; color: #64748B; background: #fff; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; transition: all .2s ease; white-space: nowrap; margin-left: 6px; }
.lib-search-law-btn:hover { border-color: #E65100; color: #E65100; background: #FFF8F0; }
.lib-search-law-btn:disabled { opacity: .5; cursor: not-allowed; }

.lib-search-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 20px; }
.lib-search-tags button { padding: 6px 14px; border: 1px solid #E8ECF2; border-radius: 99px; color: #64748B; background: #fff; font: inherit; font-size: 12px; cursor: pointer; transition: all .2s ease; }
.lib-search-tags button:hover { border-color: var(--citizen-blue); color: var(--citizen-blue-dark); background: var(--citizen-blue-soft); }

/* ─── Category Cards V2 — To, trực quan, hành động rõ ─── */
.library-cat-grid-v2 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.library-cat-card-v2 { position: relative; display: flex; flex-direction: column; border: 0; border-radius: 18px; background: #fff; cursor: pointer; overflow: hidden; text-align: left; font: inherit; color: var(--citizen-ink); transition: all .3s cubic-bezier(.4,0,.2,1); box-shadow: 0 1px 3px rgba(0,0,0,.04); opacity: 0; transform: translateY(30px); animation: searchFloatUp .6s cubic-bezier(.16,1,.3,1) forwards; }
.library-cat-card-v2:nth-child(1) { animation-delay: .4s; }
.library-cat-card-v2:nth-child(2) { animation-delay: .5s; }
.library-cat-card-v2:nth-child(3) { animation-delay: .6s; }
.library-cat-card-v2:nth-child(4) { animation-delay: .7s; }
.library-cat-card-v2:hover { transform: translateY(-6px); box-shadow: 0 16px 36px rgba(21,101,192,.12); }
.library-cat-card-v2.is-active { box-shadow: 0 0 0 3px var(--citizen-blue), 0 12px 28px rgba(37,99,235,.12); transform: translateY(-2px); }

.library-cat-visual { position: relative; height: 130px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.library-cat-icon-v2 { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 18px; color: #fff; transition: transform .35s cubic-bezier(.34,1.56,.64,1); }
.library-cat-card-v2:hover .library-cat-icon-v2 { transform: scale(1.12) rotate(-3deg); }
.library-cat-count-badge { position: absolute; top: 10px; right: 10px; min-width: 30px; height: 24px; display: grid; place-items: center; padding: 0 8px; border-radius: 99px; background: #fff; font-size: 12px; font-weight: 700; color: var(--citizen-ink); box-shadow: 0 2px 6px rgba(0,0,0,.06); }

.library-cat-body-v2 { padding: 14px 18px 18px; display: flex; flex-direction: column; flex: 1; }
.library-cat-body-v2 h3 { margin: 0 0 4px; font-size: 16px; font-weight: 700; letter-spacing: -.02em; }
.library-cat-body-v2 p { margin: 0; color: var(--citizen-muted); font-size: 12px; line-height: 1.5; flex: 1; }
.library-cat-cta-v2 { display: inline-flex; align-items: center; gap: 5px; margin-top: 12px; font-size: 12px; font-weight: 700; transition: gap .2s ease; }
.library-cat-card-v2:hover .library-cat-cta-v2 { gap: 9px; }

/* ═══ STATS STRIP ═══ */
.lib-stats-strip { padding: 48px 0; background: #fff; border-bottom: 1px solid #F0F2F5; }
.lib-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
.lib-stat-item { text-align: center; padding: 24px 16px; border-radius: 16px; background: var(--citizen-blue-soft); opacity: 0; transform: translateY(24px); animation: searchFloatUp .6s cubic-bezier(.16,1,.3,1) forwards; }
.lib-stat-icon-wrap { width: 48px; height: 48px; display: grid; place-items: center; margin: 0 auto 12px; border-radius: 14px; background: #fff; color: var(--citizen-blue); box-shadow: 0 2px 8px rgba(0,0,0,.04); }
.lib-stat-num { display: block; font-size: 30px; font-weight: 700; letter-spacing: -.03em; color: #1A1A1A; }
.lib-stat-item span { display: block; font-size: 12px; color: #8B99A6; margin-top: 4px; }

/* ═══ FEATURED SECTION ═══ */
.lib-featured-section { position: relative; padding: 72px 0; overflow: hidden; }
.lib-featured-bg { position: absolute; inset: 0; background: var(--citizen-soft); pointer-events: none; }
.lib-featured-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; position: relative; z-index: 1; }
.lib-featured-card { display: flex; flex-direction: column; border: 0; border-radius: 18px; overflow: hidden; background: #fff; cursor: pointer; text-align: left; font: inherit; color: var(--citizen-ink); box-shadow: 0 2px 16px rgba(0,0,0,.06); transition: all .3s cubic-bezier(.4,0,.2,1); opacity: 0; transform: translateY(30px); animation: searchFloatUp .6s cubic-bezier(.16,1,.3,1) forwards; }
.lib-featured-card:hover { transform: translateY(-6px); box-shadow: 0 20px 40px rgba(0,0,0,.12); }
.lib-featured-img { position: relative; height: 200px; overflow: hidden; }
.lib-featured-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
.lib-featured-card:hover .lib-featured-img img { transform: scale(1.06); }
.lib-featured-overlay { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0,0,0,.45) 0%, transparent 50%); }
.lib-featured-badge { position: absolute; top: 14px; left: 14px; padding: 5px 12px; border-radius: 7px; color: #fff; font-size: 11px; font-weight: 700; letter-spacing: .03em; z-index: 1; }
.lib-featured-body { padding: 20px 22px 24px; display: flex; flex-direction: column; flex: 1; }
.lib-featured-body h3 { margin: 0 0 8px; font-size: 18px; font-weight: 700; line-height: 1.4; letter-spacing: -.02em; }
.lib-featured-body p { margin: 0; color: #7B8A98; font-size: 13px; line-height: 1.6; flex: 1; }
.lib-featured-meta { display: flex; gap: 16px; margin-top: 14px; font-size: 12px; color: #8B99A6; }
.lib-featured-cta { display: inline-flex; align-items: center; gap: 6px; margin-top: 16px; color: #1A1A1A; font-size: 13px; font-weight: 700; transition: gap .2s ease; }
.lib-featured-card:hover .lib-featured-cta { gap: 10px; }

/* ═══ FILTER BAR ═══ */
.lib-filter-bar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
.lib-filter-chip-v2 { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border: 1.5px solid #E2E8F0; border-radius: 10px; background: #fff; color: #64748B; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; transition: all .2s ease; }
.lib-filter-chip-v2:hover { border-color: #CBD5E1; color: var(--citizen-ink); background: #F8FAFC; }
.lib-filter-chip-v2.active { border-color: var(--citizen-blue); color: var(--citizen-blue-dark); background: var(--citizen-blue-soft); }
.lib-filter-chip-count { display: inline-flex; align-items: center; justify-content: center; min-width: 20px; height: 20px; padding: 0 6px; border-radius: 6px; background: #F0F2F5; font-size: 11px; font-weight: 700; color: #94A3B8; }
.lib-filter-chip-v2.active .lib-filter-chip-count { background: #fff; color: var(--citizen-blue); }
.lib-load-more { display: flex; justify-content: center; margin-top: 40px; }

/* ═══ DOC GRID V2 ═══ */
.lib-doc-grid-v2 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
.lib-doc-card-v2 { display: flex; flex-direction: column; border: 1px solid #EAEEF3; border-radius: 16px; overflow: hidden; background: #fff; cursor: pointer; text-align: left; font: inherit; color: var(--citizen-ink); transition: all .28s cubic-bezier(.4,0,.2,1); }
.lib-doc-card-v2:hover { transform: translateY(-5px); box-shadow: 0 16px 36px rgba(21,101,192,.10); border-color: #CBD5E1; }
.lib-doc-img-v2 { position: relative; height: 170px; overflow: hidden; background: #EDF0F4; }
.lib-doc-img-v2 img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
.lib-doc-card-v2:hover .lib-doc-img-v2 img { transform: scale(1.06); }
.lib-doc-overlay-v2 { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; background: rgba(0,0,0,.35); color: #fff; opacity: 0; transition: opacity .25s ease; font-size: 13px; font-weight: 600; z-index: 1; }
.lib-doc-card-v2:hover .lib-doc-overlay-v2 { opacity: 1; }
.lib-doc-badge-v2 { position: absolute; top: 10px; left: 10px; display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 6px; color: #fff; font-size: 10px; font-weight: 700; letter-spacing: .02em; z-index: 2; }
.lib-doc-body-v2 { padding: 14px 16px 16px; display: flex; flex-direction: column; flex: 1; }
.lib-doc-type-v2 { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; letter-spacing: .02em; margin-bottom: 6px; }
.lib-doc-body-v2 h4 { margin: 0 0 6px; font-size: 15px; font-weight: 700; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.lib-doc-body-v2 > p { margin: 0 0 10px; font-size: 12px; color: var(--citizen-muted); line-height: 1.5; flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.lib-doc-foot-v2 { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 10px; border-top: 1px solid #F0F3F6; }
.lib-doc-meta-left { display: flex; flex-direction: column; gap: 2px; }
.lib-doc-author-v2 { font-size: 11px; color: var(--citizen-muted); }
.lib-doc-dl { font-size: 11px; color: var(--citizen-muted); display: flex; align-items: center; gap: 3px; }
.lib-doc-read { display: flex; align-items: center; gap: 4px; color: var(--citizen-blue); font-size: 12px; font-weight: 700; white-space: nowrap; opacity: 0; transform: translateX(-6px); transition: all .2s ease; }
.lib-doc-card-v2:hover .lib-doc-read { opacity: 1; transform: translateX(0); }

/* ═══ DETAIL CONTENT ═══ */
.lib-detail-content { max-width: 1500px; margin: 0 auto; padding: 0 32px; }
.lib-detail-desc { margin-bottom: 40px; }
.lib-detail-desc h3 { margin: 0 0 14px; font-size: 20px; font-weight: 700; color: var(--citizen-ink); }
.lib-detail-desc p { margin: 0; font-size: 15px; color: #475569; line-height: 1.9; }
.lib-detail-trust { display: flex; gap: 12px; align-items: flex-start; margin-top: 40px; padding: 20px 24px; border-radius: 14px; background: var(--citizen-blue-soft); color: var(--citizen-blue-dark); font-size: 13px; line-height: 1.7; }
.lib-detail-trust svg { flex: 0 0 auto; margin-top: 2px; }

/* ═══ RELATED SCROLL ═══ */
.lib-related-scroll { display: flex; gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: thin; scrollbar-color: #CBD5E1 transparent; padding-bottom: 8px; }
.lib-related-scroll::-webkit-scrollbar { height: 6px; }
.lib-related-scroll::-webkit-scrollbar-track { background: transparent; }
.lib-related-scroll::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 99px; }
.lib-related-item { flex: 0 0 275px; scroll-snap-align: start; }

.lib-legal-info { padding: 24px 28px; border-radius: 14px; background: #fff; border: 1px solid #E2E8F0; margin-bottom: 32px; }
.lib-legal-info h3 { display: flex; align-items: center; gap: 8px; margin: 0 0 18px; font-size: 16px; color: var(--citizen-ink); }
.lib-legal-info h3 svg { color: var(--citizen-blue); }
.lib-legal-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.lib-legal-grid > div { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; border-radius: 10px; background: #F8FAFC; }
.lib-legal-grid span { font-size: 11px; color: var(--citizen-muted); text-transform: uppercase; letter-spacing: .03em; }
.lib-legal-grid strong { font-size: 14px; color: var(--citizen-ink); }
.lib-legal-status { color: #059669 !important; display: inline-flex; align-items: center; gap: 4px; }
.lib-legal-status::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #059669; flex: 0 0 auto; }

.lib-sections { margin-bottom: 0; }
.lib-sections > h3 { margin: 0 0 20px; font-size: 20px; font-weight: 700; color: var(--citizen-ink); }
.lib-section-block { padding: 24px 28px; border-radius: 14px; background: #fff; border: 1px solid #E8ECF2; margin-bottom: 14px; transition: all .2s ease; }
.lib-section-block:hover { border-color: #CBD5E1; box-shadow: 0 2px 8px rgba(0,0,0,.03); }
.lib-section-block h4 { margin: 0 0 10px; font-size: 15px; font-weight: 700; color: var(--citizen-blue-dark); }
.lib-section-block p { margin: 0; font-size: 14px; color: #475569; line-height: 1.85; }
.lib-detail-hero { position: relative; }

/* ═══ RESULTS LIST ═══ */
.lib-results-list { display: grid; gap: 10px; }
.lib-result-row { display: flex; align-items: center; gap: 20px; padding: 16px 20px; border: 1px solid #E8ECF2; border-radius: 14px; background: #fff; cursor: pointer; transition: all .2s ease; text-align: left; color: var(--citizen-ink); width: 100%; }
.lib-result-row:hover { border-color: #CBD5E1; box-shadow: 0 4px 16px rgba(0,0,0,.05); transform: translateX(4px); }
.lib-result-law { border-left: 3px solid #E65100; }
.lib-result-thumb { width: 72px; height: 52px; border-radius: 8px; overflow: hidden; background: #EDF0F4; flex: 0 0 auto; }
.lib-result-thumb img { width: 100%; height: 100%; object-fit: cover; }
.lib-result-thumb-law { display: grid; place-items: center; background: #FFF0E0; color: #E65100; }
.lib-result-info { flex: 1; min-width: 0; }
.lib-result-type { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; letter-spacing: .02em; margin-bottom: 3px; }
.lib-result-info h4 { margin: 0 0 4px; font-size: 15px; font-weight: 700; line-height: 1.3; }
.lib-result-info p { margin: 0 0 4px; font-size: 12px; color: var(--citizen-muted); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.lib-result-meta { font-size: 11px; color: var(--citizen-muted); }
.lib-result-action { flex: 0 0 auto; color: var(--citizen-blue); font-size: 13px; font-weight: 700; display: flex; align-items: center; gap: 4px; opacity: 0; transform: translateX(-8px); transition: all .2s ease; }
.lib-result-row:hover .lib-result-action { opacity: 1; transform: translateX(0); }

/* ═══ LAW MINI CARD ═══ */
.lib-law-mini { display: flex; flex-direction: column; gap: 4px; padding: 20px; border: 1px solid #FFE4CC; border-radius: 14px; background: #FFFBF7; cursor: pointer; transition: all .22s ease; font: inherit; color: var(--citizen-ink); text-align: left; position: relative; overflow: hidden; }
.lib-law-mini::before { position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: #E65100; content: ''; border-radius: 0 2px 2px 0; }
.lib-law-mini:hover { border-color: #FED7AA; box-shadow: 0 6px 18px rgba(234,88,12,.08); transform: translateY(-2px); }
.lib-law-mini h4 { margin: 0 0 4px; font-size: 14px; font-weight: 700; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; padding-left: 6px; }
.lib-law-mini p { margin: 0 0 6px; font-size: 11px; color: var(--citizen-muted); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; padding-left: 6px; }
.lib-law-mini-meta { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: auto; padding-top: 8px; border-top: 1px solid #FFEDD5; font-size: 10px; color: var(--citizen-muted); padding-left: 6px; }
.lib-law-mini-cta { display: flex; align-items: center; gap: 3px; margin-top: 4px; color: #E65100; font-size: 11px; font-weight: 700; padding-left: 6px; }
.lib-law-type-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; background: #FFF0E0; color: #E65100; font-size: 10px; font-weight: 700; letter-spacing: .02em; width: fit-content; }
.lib-law-list { display: grid; gap: 16px; }
.lib-law-card { display: flex; gap: 28px; padding: 24px 28px; border: 1px solid #E8ECF2; border-radius: 16px; background: #fff; transition: all .2s ease; }
.lib-law-card:hover { border-color: #CBD5E1; box-shadow: 0 4px 16px rgba(0,0,0,.05); }
.lib-law-card-left { flex: 1; min-width: 0; }
.lib-law-type-badge { display: inline-block; padding: 3px 10px; border-radius: 6px; background: #FFF3E0; color: #E65100; font-size: 11px; font-weight: 700; letter-spacing: .03em; margin-bottom: 8px; }
.lib-law-card-left h3 { margin: 0 0 8px; font-size: 17px; font-weight: 700; line-height: 1.4; color: var(--citizen-ink); }
.lib-law-card-left p { margin: 0 0 12px; font-size: 13px; color: var(--citizen-muted); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.lib-law-meta { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 12px; color: var(--citizen-muted); }
.lib-law-meta strong { color: var(--citizen-ink); }
.lib-law-status { color: #059669 !important; font-weight: 600; }
.lib-law-card-right { display: flex; flex-direction: column; align-items: flex-end; justify-content: center; gap: 12px; flex: 0 0 auto; }
.lib-law-actions { display: flex; flex-direction: column; gap: 8px; }
.lib-law-dl-count { font-size: 12px; color: var(--citizen-muted); display: flex; align-items: center; gap: 4px; }
.lib-cta-banner { position: relative; overflow: hidden; padding: 80px 0; }
.lib-cta-bg { position: absolute; inset: 0; background: linear-gradient(160deg, #0F2440 0%, #132E52 45%, #0A1628 100%), url('https://images.unsplash.com/photo-1481627834876-b7833e8f5570?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat; background-blend-mode: overlay; pointer-events: none; }
.lib-cta-inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr auto; gap: 48px; align-items: center; }
.lib-cta-content { color: #fff; }
.lib-cta-content h2 { margin: 0 0 14px; font-size: clamp(26px, 3.5vw, 38px); letter-spacing: -.035em; line-height: 1.2; }
.lib-cta-content > p { margin: 0 0 28px; color: rgba(255,255,255,.55); font-size: 15px; line-height: 1.7; max-width: 520px; }
.lib-cta-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.lib-cta-visual { flex: 0 0 auto; }
.lib-cta-card { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 32px 28px; border-radius: 20px; background: rgba(255,255,255,.08); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,.10); text-align: center; color: #fff; }
.lib-cta-card svg { color: #60A5FA; }
.lib-cta-card strong { font-size: 36px; font-weight: 700; letter-spacing: -.03em; }
.lib-cta-card span { font-size: 12px; color: rgba(255,255,255,.50); line-height: 1.5; }

/* ═══ SECTION HEADING V2 ═══ */
.lib-section-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 32px; }
.lib-section-tag { display: inline-block; padding: 4px 12px; border-radius: 6px; background: var(--citizen-blue-soft); color: var(--citizen-blue-dark); font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 12px; }
.lib-section-title { margin: 0 0 10px; font-size: clamp(26px, 3vw, 36px); font-weight: 700; letter-spacing: -.035em; line-height: 1.2; color: var(--citizen-ink); }
.lib-section-desc { margin: 0; color: var(--citizen-muted); font-size: 15px; line-height: 1.6; max-width: 560px; }
.lib-filter-chip { display: inline-block; padding: 3px 10px; border-radius: 6px; background: var(--citizen-blue); color: #fff; font-size: 13px; font-weight: 600; }
.lib-filter-clear { padding: 8px 16px; border: 1px solid #D0D5DD; border-radius: 8px; background: #fff; color: #6B7B8A; font: inherit; font-size: 12px; font-weight: 600; cursor: pointer; white-space: nowrap; transition: all .2s ease; }
.lib-filter-clear:hover { border-color: var(--citizen-blue); color: var(--citizen-blue-dark); background: var(--citizen-blue-soft); }
.lib-how-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.lib-how-card { position: relative; padding: 32px 24px 28px; border-radius: 18px; background: var(--citizen-soft); transition: all .25s ease; }
.lib-how-card:hover { background: var(--citizen-blue-soft); transform: translateY(-3px); }
.lib-how-step { display: block; font-size: 48px; font-weight: 800; letter-spacing: -.04em; color: #CBD5E1; line-height: 1; margin-bottom: -8px; transition: all .3s ease; }
.lib-how-card:hover .lib-how-step { color: var(--citizen-blue); text-shadow: 0 0 24px rgba(37,99,235,.40); }
.lib-how-icon { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 12px; background: #fff; color: var(--citizen-blue); margin: 12px 0 16px; box-shadow: 0 2px 8px rgba(0,0,0,.04); }
.lib-how-card h3 { margin: 0 0 8px; font-size: 17px; font-weight: 700; }
.lib-how-card p { margin: 0; color: #7B8A98; font-size: 13px; line-height: 1.6; }

/* Grid tài liệu (đọc nhiều nhất) */
.library-doc-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }

/* Mini stat trên Hero (giữ lại cho tương thích) */
.library-hero-stats { display: flex; justify-content: center; gap: 36px; margin-top: 42px; }
.library-hero-stat { text-align: center; }
.library-hero-stat strong { display: block; font-size: 28px; font-weight: 700; letter-spacing: -.03em; }
.library-hero-stat span { display: block; color: rgba(255,255,255,.65); font-size: 12px; margin-top: 4px; }

/* Trang chi tiết tài liệu */
.library-detail-layout { display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 48px; align-items: start; }
.library-detail-cover { width: 100%; border-radius: 16px; box-shadow: 0 18px 40px rgba(21,101,192,.14); }
.library-detail-meta { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 20px; }
.library-detail-meta > div { display: flex; align-items: center; gap: 8px; color: var(--citizen-muted); font-size: 13px; }
.library-detail-meta > div svg { color: var(--citizen-blue); }
.library-detail-title { font-size: clamp(28px, 3.5vw, 38px); letter-spacing: -.04em; line-height: 1.2; margin: 0 0 14px; }
.library-detail-author { color: var(--citizen-muted); font-size: 15px; margin: 0 0 28px; }
.library-detail-description { color: #3D5068; font-size: 16px; line-height: 1.85; margin: 0 0 32px; }
.library-detail-actions { display: flex; flex-wrap: wrap; gap: 12px; }

/* Responsive Thư viện số */
@media (max-width: 1100px) {
  .library-cat-grid-v2 { grid-template-columns: repeat(2, 1fr); }
  .library-cat-visual { height: 110px; }
  .library-cat-icon-v2 { width: 52px; height: 52px; border-radius: 14px; }
  .library-doc-grid { grid-template-columns: repeat(3, 1fr); }
  .library-detail-layout { grid-template-columns: 260px minmax(0, 1fr); gap: 32px; }
  .shape-1, .shape-3 { left: 3%; }
}
@media (max-width: 900px) {
  .library-hero { padding: 64px 0 52px; }
  .library-hero h1 { font-size: clamp(28px, 4vw, 38px); }
  .library-hero-sub { font-size: 14px; margin-bottom: 24px; }
  .hero-pillars { gap: 20px; }
  .hero-pillar-icon { width: 36px; height: 36px; border-radius: 10px; }
  .hero-pillar strong { font-size: 16px; }
  .library-search-section { margin-top: -20px; padding: 0 16px 36px; }
  .lib-search-hero { padding: 28px 24px; border-radius: 18px; }
  .lib-search-bar { flex-wrap: wrap; padding: 12px; gap: 8px; }
  .lib-search-bar-icon { display: none; }
  .lib-search-bar-input { min-width: 100%; }
  .lib-search-bar-btn { width: 100%; justify-content: center; }
  .lib-results-grid { grid-template-columns: repeat(3, 1fr); }
  .lib-featured-grid { grid-template-columns: repeat(2, 1fr); }
  .lib-doc-grid-v2 { grid-template-columns: repeat(2, 1fr); }
  .lib-how-grid { grid-template-columns: repeat(2, 1fr); }
  .lib-cta-inner { grid-template-columns: 1fr; gap: 32px; }
  .lib-cta-visual { display: flex; justify-content: center; }
  .library-detail-layout { grid-template-columns: 1fr; }
  .library-detail-cover { max-width: 300px; }
}
@media (max-width: 680px) {
  .library-hero { padding: 48px 0 40px; }
  .library-hero h1 { font-size: 28px; }
  .library-hero h1 br { display: none; }
  .library-hero-sub { font-size: 13px; margin-bottom: 20px; }
  .hero-pillars { flex-direction: column; gap: 14px; }
  .hero-pillar-divider { width: 36px; height: 1px; }
  .library-search-section { margin-top: -16px; padding: 0 12px 16px; }
  .lib-search-hero { padding: 24px 18px; border-radius: 16px; }
  .lib-search-hero-text h2 { font-size: 18px; }
  .lib-search-bar-input { font-size: 14px; }
  .library-hero-search .citizen-search { min-height: 52px; padding: 5px 6px 5px 16px; border-radius: 14px; }
  .library-hero-search .citizen-search input { font-size: 14px; }
  .library-hero-search .citizen-search .citizen-button { min-height: 40px; min-width: 100px; font-size: 13px; }
  .library-cat-grid-v2 { grid-template-columns: 1fr; }
  .library-cat-visual { height: 100px; }
  .library-cat-icon-v2 { width: 48px; height: 48px; border-radius: 12px; }
  .lib-results-grid { grid-template-columns: 1fr 1fr; }
  .lib-stat-item { padding: 18px 12px; }
  .lib-stat-num { font-size: 24px; }
  .lib-featured-grid, .lib-doc-grid-v2, .lib-how-grid { grid-template-columns: 1fr; }
  .lib-featured-img { height: 160px; }
  .lib-cta-banner { padding: 48px 0; }
  .lib-cta-content h2 { font-size: 24px; }
  .lib-how-step { font-size: 36px; }
  .library-doc-card { min-width: 0; }
  .library-carousel .library-doc-card { flex: 0 0 240px; }
  .library-carousel .library-doc-cover { height: 165px; }
  .library-doc-body { padding: 14px 16px 16px; }
  .library-doc-body h3 { font-size: 15px; }
}

/* ═══ SCROLL REVEAL ═══ */
.reveal { opacity: 0; transform: translateY(36px); transition: opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1); }
.revealed { opacity: 1; transform: translateY(0); }

/* ═══ DETAIL V2 ═══ */
.lib-detail-hero-v2 { position: relative; padding: 40px 0 0; overflow: hidden; }
.lib-detail-hero-bg { position: absolute; inset: 0; height: 340px; background: center/cover no-repeat; filter: blur(20px) brightness(.35); transform: scale(1.1); }
.lib-detail-hero-bg::after { position: absolute; inset: 0; content: ''; background: linear-gradient(180deg, rgba(0,0,0,.3) 0%, transparent 60%, #fff 100%); }
.lib-detail-hero-inner { position: relative; z-index: 1; }
.lib-detail-hero-card { display: flex; gap: 36px; margin-top: 20px; padding: 32px; border-radius: 20px 20px 0 0; background: #fff; }
.lib-detail-hero-img { width: 220px; height: 300px; border-radius: 12px; overflow: hidden; box-shadow: 0 12px 32px rgba(0,0,0,.15); flex: 0 0 auto; }
.lib-detail-hero-img img { width: 100%; height: 100%; object-fit: cover; }
.lib-detail-hero-body { flex: 1; display: flex; flex-direction: column; justify-content: center; min-width: 0; }
.lib-detail-hero-tag { display: inline-block; padding: 4px 12px; border-radius: 6px; color: #fff; font-size: 11px; font-weight: 700; letter-spacing: .03em; width: fit-content; margin-bottom: 12px; }
.lib-detail-hero-body h1 { margin: 0 0 12px; font-size: clamp(24px, 3vw, 34px); font-weight: 700; letter-spacing: -.03em; line-height: 1.2; color: var(--citizen-ink); }
.lib-detail-hero-meta { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 13px; color: var(--citizen-muted); margin-bottom: 12px; }
.lib-detail-hero-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 18px; }
.lib-detail-hero-tags span { padding: 3px 10px; border-radius: 99px; background: #F0F4F8; color: #64748B; font-size: 11px; }
.lib-detail-hero-actions { display: flex; flex-wrap: wrap; gap: 10px; }

.lib-detail-layout-v2 { display: grid; grid-template-columns: 260px 1fr; gap: 48px; align-items: start; }
.lib-detail-sidebar { position: sticky; top: 100px; }
.lib-detail-side-card { padding: 20px; border-radius: 14px; background: #F8FAFC; border: 1px solid #E8ECF2; margin-bottom: 16px; }
.lib-detail-side-card h4 { display: flex; align-items: center; gap: 6px; margin: 0 0 14px; font-size: 13px; font-weight: 700; color: var(--citizen-ink); }
.lib-detail-side-card h4 svg { color: var(--citizen-blue); }
.lib-detail-side-row { padding: 8px 0; border-top: 1px solid #EEF1F5; }
.lib-detail-side-row:first-of-type { border-top: 0; }
.lib-detail-side-row span { display: block; font-size: 10px; color: var(--citizen-muted); text-transform: uppercase; letter-spacing: .03em; }
.lib-detail-side-row strong { display: block; font-size: 13px; color: var(--citizen-ink); margin-top: 2px; }
.lib-detail-toc-link { display: block; padding: 6px 0; font-size: 12px; color: var(--citizen-muted); text-decoration: none; border-top: 1px solid #EEF1F5; transition: color .15s ease; }
.lib-detail-toc-link:hover { color: var(--citizen-blue); }
.lib-detail-toc-link:first-of-type { border-top: 0; }

.lib-detail-main { min-width: 0; }
.lib-detail-section { margin-bottom: 40px; }
.lib-detail-section h3 { margin: 0 0 12px; font-size: 20px; font-weight: 700; color: var(--citizen-ink); letter-spacing: -.02em; }
.lib-detail-section p { margin: 0; font-size: 15px; color: #475569; line-height: 1.9; }

@media (max-width: 900px) {
  .lib-detail-layout-v2 { grid-template-columns: 1fr; }
  .lib-detail-sidebar { position: static; }
  .lib-detail-hero-card { flex-direction: column; padding: 24px; }
  .lib-detail-hero-img { width: 160px; height: 220px; }
}

/* ═══════════════════════════════════════════════
   HOME STATS STRIP — Số liệu nổi bật trang chủ
   ═══════════════════════════════════════════════ */
.home-stats-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  padding: 36px 0 48px;
}
.home-stat-item {
  text-align: center;
  padding: 28px 18px 24px;
  border-radius: 18px;
  background: #fff;
  border: 1px solid #EEF1F5;
  transition: all .28s ease;
}
.home-stat-item:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 32px rgba(21,101,192,.08);
}
.home-stat-icon {
  width: 50px;
  height: 50px;
  display: grid;
  place-items: center;
  margin: 0 auto 14px;
  border-radius: 14px;
}
.home-stat-num {
  display: block;
  font-size: 32px;
  font-weight: 700;
  letter-spacing: -.035em;
  color: var(--citizen-ink);
}
.home-stat-item span {
  display: block;
  font-size: 13px;
  color: var(--citizen-muted);
  margin-top: 6px;
}
@media (max-width: 780px) {
  .home-stats-strip { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .home-stat-item { padding: 20px 14px 18px; }
  .home-stat-num { font-size: 26px; }
}
@media (max-width: 480px) {
  .home-stats-strip { grid-template-columns: 1fr 1fr; gap: 10px; }
}

/* ═══════════════════════════════════════════════
   FEATURE CARDS V2 — Thiết kế cho người dân dễ hiểu
   ═══════════════════════════════════════════════ */
.citizen-mobile-feature-grid-v2 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.citizen-mobile-feature-v2 {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
  padding: 14px 14px 12px;
  border: 2px solid #E8EDF3;
  border-radius: 12px;
  color: var(--citizen-ink);
  text-decoration: none;
  background: #fff;
  transition: all .28s cubic-bezier(.4,0,.2,1);
  overflow: hidden;
}
.citizen-mobile-feature-v2::after {
  content: '';
  position: absolute;
  top: -30px;
  right: -30px;
  width: 90px;
  height: 90px;
  border-radius: 50%;
  background: var(--feat-bg, #EFF6FF);
  opacity: .5;
  transition: transform .35s ease;
}
.citizen-mobile-feature-v2:hover {
  transform: translateY(-6px);
  border-color: rgba(37,99,235,.35);
  box-shadow: 0 18px 38px rgba(21,101,192,.13);
}
.citizen-mobile-feature-v2:hover::after {
  transform: scale(1.5);
}
.citizen-mobile-feature-v2.feature-hero {
  grid-column: span 2;
  border-color: transparent;
  color: #fff;
  background: linear-gradient(145deg, #1565C0, #2563EB);
  box-shadow: 0 10px 32px rgba(21,101,192,.22);
}
.citizen-mobile-feature-v2.feature-hero:last-child {
  background: linear-gradient(145deg, #15803D, #16A34A);
}
.citizen-mobile-feature-v2.feature-hero::after {
  background: rgba(255,255,255,.08);
  top: -50px;
  right: -50px;
  width: 150px;
  height: 150px;
}
.citizen-mobile-feature-v2.feature-hero small {
  color: rgba(255,255,255,.75);
}
.citizen-mobile-feature-v2.feature-hero .feature-action {
  color: #fff;
  border-color: rgba(255,255,255,.5);
}
.feature-number-badge {
  position: absolute;
  top: 8px;
  right: 10px;
  font-size: 30px;
  font-weight: 800;
  letter-spacing: -.04em;
  color: rgba(37,99,235,.15);
  line-height: 1;
  pointer-events: none;
  transition: all .3s cubic-bezier(.4,0,.2,1);
}
.citizen-mobile-feature-v2:hover .feature-number-badge {
  color: #2563EB;
  text-shadow: 0 0 16px rgba(37,99,235,.90), 0 0 40px rgba(37,99,235,.70), 0 0 70px rgba(37,99,235,.40), 0 0 100px rgba(37,99,235,.20);
  transform: scale(1.18);
}
.feature-hero .feature-number-badge {
  color: rgba(255,255,255,.20);
}
.feature-hero:hover .feature-number-badge {
  color: #fff;
  text-shadow: 0 0 20px rgba(255,255,255,.95), 0 0 50px rgba(255,255,255,.70), 0 0 80px rgba(255,255,255,.40), 0 0 120px rgba(255,255,255,.20);
  transform: scale(1.18);
}
.feature-hero .feature-number-badge {
  color: rgba(255,255,255,.12);
}
.citizen-mobile-feature-icon-v2 {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  flex: 0 0 auto;
  box-shadow: 0 3px 10px rgba(0,0,0,.06);
  transition: transform .3s ease;
}
.citizen-mobile-feature-v2:hover .citizen-mobile-feature-icon-v2 {
  transform: scale(1.08) rotate(-4deg);
}
.feature-hero .citizen-mobile-feature-icon-v2 {
  width: 38px;
  height: 38px;
  color: #2563EB !important;
  background: #fff !important;
}
.feature-hero:last-child .citizen-mobile-feature-icon-v2 {
  color: #16A34A !important;
  background: #fff !important;
}
.citizen-mobile-feature-v2 strong {
  font-size: 13px;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: -.02em;
}
.citizen-mobile-feature-v2 small {
  color: var(--citizen-muted);
  font-size: 11px;
  line-height: 1.4;
  max-width: 200px;
}
.feature-action {
  display: inline-flex;
  align-items: center;
  margin-top: auto;
  padding-top: 6px;
  font-size: 11px;
  font-weight: 700;
  color: var(--citizen-blue);
  opacity: 0;
  transform: translateY(6px);
  transition: all .25s ease;
}
.citizen-mobile-feature-v2:hover .feature-action {
  opacity: 1;
  transform: translateY(0);
}
@media (max-width: 1100px) {
  .citizen-mobile-feature-grid-v2 { grid-template-columns: repeat(3, 1fr); }
  .citizen-mobile-feature-v2.feature-hero { grid-column: span 2; }
}
@media (max-width: 780px) {
  .citizen-mobile-feature-grid-v2 { grid-template-columns: 1fr 1fr; gap: 12px; }
  .citizen-mobile-feature-v2.feature-hero { grid-column: span 2; }
}
@media (max-width: 680px) {
  .citizen-mobile-feature-v2 { padding: 18px 14px 16px; gap: 7px; }
  .feature-number-badge { font-size: 28px; top: 8px; right: 10px; }
  .citizen-mobile-feature-icon-v2 { width: 42px; height: 42px; border-radius: 12px; }
  .citizen-mobile-feature-v2 strong { font-size: 14px; }
  .citizen-mobile-feature-v2 small { font-size: 11px; }
}

/* ═══════════════════════════════════════════════
   NOTICE CARDS V2 + EMERGENCY CARD V2
   ═══════════════════════════════════════════════ */
.notice-card-v2 {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 18px 20px;
  border: 1px solid #E8EDF3;
  border-radius: 14px;
  color: var(--citizen-ink);
  text-decoration: none;
  background: #fff;
  transition: all .25s ease;
}
.notice-card-v2:hover {
  border-color: var(--citizen-blue);
  box-shadow: 0 8px 24px rgba(21,101,192,.08);
  transform: translateX(4px);
}
.notice-card-left { flex: 0 0 auto; }
.notice-icon-badge {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  font-size: 18px;
  font-weight: 800;
  color: var(--citizen-blue-dark);
  background: var(--citizen-blue-soft);
}
.notice-icon-badge.is-urgent {
  color: #fff;
  background: #E53935;
  animation: urgentPulse 2s ease-in-out infinite;
}
@keyframes urgentPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(229,57,53,.35); } 50% { box-shadow: 0 0 0 10px rgba(229,57,53,0); } }
.notice-card-body { flex: 1; min-width: 0; }
.notice-card-top {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}
.notice-type-tag {
  padding: 3px 8px;
  border-radius: 5px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
  color: var(--citizen-blue-dark);
  background: var(--citizen-blue-soft);
}
.notice-type-tag.is-urgent { color: #E53935; background: #FFEBEE; }
.notice-type-tag.is-new { color: #059669; background: #ECFDF5; }
.notice-card-top time { color: var(--citizen-muted); font-size: 11px; margin-left: auto; }
.notice-card-body strong {
  font-size: 15px;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: -.02em;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.notice-card-arrow {
  flex: 0 0 auto;
  color: #B0B8C1;
  opacity: 0;
  transform: translateX(-8px);
  transition: all .25s ease;
}
.notice-card-v2:hover .notice-card-arrow {
  opacity: 1;
  transform: translateX(0);
  color: var(--citizen-blue);
}

/* ─── Emergency Card V2 ─── */
.citizen-emergency-card {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 28px;
  border-radius: 16px;
  color: #fff;
  background: linear-gradient(145deg, #1E3A5F, #1565C0);
  box-shadow: 0 12px 32px rgba(21,101,192,.18);
}
.emergency-top {
  display: flex;
  align-items: center;
  gap: 16px;
}
.emergency-icon-ring {
  width: 50px;
  height: 50px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border-radius: 50%;
  background: rgba(255,255,255,.15);
  color: #fff;
}
.emergency-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: rgba(255,255,255,.55);
  margin: 0 0 2px;
}
.citizen-emergency-card h2 {
  margin: 0;
  font-size: 21px;
  font-weight: 700;
  letter-spacing: -.03em;
  line-height: 1.25;
}
.emergency-desc {
  margin: 0;
  color: rgba(255,255,255,.60);
  font-size: 13px;
  line-height: 1.6;
}
.emergency-actions { display: flex; flex-direction: column; gap: 8px; }
.emergency-actions .citizen-button { width: 100%; justify-content: center; }

@media (max-width: 680px) {
  .notice-card-v2 { padding: 14px 16px; gap: 12px; }
  .notice-icon-badge { width: 36px; height: 36px; font-size: 16px; border-radius: 10px; }
  .citizen-emergency-card { padding: 22px; gap: 14px; }
}

/* ═══════════════════════════════════════════════
   PROCEDURE CARDS V2
   ═══════════════════════════════════════════════ */
.procedure-card-v2 {
  display: flex;
  align-items: flex-start;
  gap: 18px;
  padding: 22px;
  border: 1px solid #E8EDF3;
  border-radius: 16px;
  color: var(--citizen-ink);
  text-decoration: none;
  background: #fff;
  transition: all .28s cubic-bezier(.4,0,.2,1);
}
.procedure-card-v2:hover {
  transform: translateY(-4px);
  border-color: var(--citizen-blue);
  box-shadow: 0 14px 32px rgba(21,101,192,.10);
}
.pc-icon-wrap {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  flex: 0 0 auto;
  border-radius: 13px;
  color: var(--citizen-blue-dark);
  background: var(--citizen-blue-soft);
  transition: all .3s ease;
}
.procedure-card-v2:hover .pc-icon-wrap {
  color: #fff;
  background: var(--citizen-blue);
  transform: scale(1.05);
}
.pc-body { flex: 1; min-width: 0; }
.pc-category {
  display: inline-block;
  padding: 3px 8px;
  border-radius: 5px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .05em;
  text-transform: uppercase;
  color: var(--citizen-blue-dark);
  background: var(--citizen-blue-soft);
  margin-bottom: 8px;
}
.pc-body h3 {
  margin: 0 0 6px;
  font-size: 17px;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: -.02em;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.pc-body > p {
  margin: 0 0 12px;
  color: var(--citizen-muted);
  font-size: 13px;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.pc-meta {
  display: flex;
  gap: 16px;
  padding-top: 12px;
  border-top: 1px solid #F0F3F6;
}
.pc-meta-item {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--citizen-muted);
  font-size: 12px;
}
.pc-arrow {
  flex: 0 0 auto;
  color: #CBD5E1;
  margin-top: 4px;
  opacity: 0;
  transform: translateX(-6px);
  transition: all .25s ease;
}
.procedure-card-v2:hover .pc-arrow {
  opacity: 1;
  transform: translateX(0);
  color: var(--citizen-blue);
}

/* ═══════════════════════════════════════════════
   NEWS CARDS V2
   ═══════════════════════════════════════════════ */
.news-card-v2 {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid #E8EDF3;
  border-radius: 16px;
  color: var(--citizen-ink);
  text-decoration: none;
  background: #fff;
  transition: all .28s cubic-bezier(.4,0,.2,1);
}
.news-card-v2:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 32px rgba(21,101,192,.10);
}
.nc-img-wrap {
  position: relative;
  height: 190px;
  overflow: hidden;
  background: #EDF0F4;
}
.news-featured .nc-img-wrap { height: 260px; }
.nc-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .5s ease;
}
.news-card-v2:hover .nc-img-wrap img { transform: scale(1.06); }
.nc-img-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(10,22,48,.40);
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  opacity: 0;
  transition: opacity .25s ease;
}
.news-card-v2:hover .nc-img-overlay { opacity: 1; }
.nc-category-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  padding: 4px 10px;
  border-radius: 6px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
  color: #fff;
  background: var(--citizen-blue);
  z-index: 1;
}
.nc-body { padding: 16px 18px 20px; flex: 1; display: flex; flex-direction: column; }
.nc-meta {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
}
.nc-meta span {
  color: var(--citizen-blue);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .03em;
}
.nc-meta time { color: var(--citizen-muted); font-size: 11px; }
.nc-body h3 {
  margin: 0 0 8px;
  font-size: 17px;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: -.02em;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.nc-body > p {
  margin: 0;
  color: var(--citizen-muted);
  font-size: 13px;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1;
}

/* ═══════════════════════════════════════════════
   PROCESS STEPS V2
   ═══════════════════════════════════════════════ */
.process-steps-v2 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
}
.ps-step {
  position: relative;
  padding: 28px 22px 24px;
  text-align: center;
}
.ps-step-top {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}
.ps-num {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  flex: 0 0 auto;
  border-radius: 50%;
  font-size: 16px;
  font-weight: 800;
  letter-spacing: -.03em;
  color: #fff;
  background: var(--citizen-blue);
  z-index: 1;
  transition: all .3s ease;
}
.ps-step:hover .ps-num {
  transform: scale(1.12);
  box-shadow: 0 6px 20px rgba(37,99,235,.35);
}
.ps-line {
  flex: 1;
  height: 2px;
  background: linear-gradient(90deg, var(--citizen-blue), #CBD5E1 60%);
  margin: 0 -4px;
}
.ps-step:last-child .ps-line { display: none; }
.ps-icon {
  display: grid;
  place-items: center;
  width: 52px;
  height: 52px;
  margin: 0 auto 14px;
  border-radius: 14px;
  color: var(--citizen-blue-dark);
  background: var(--citizen-blue-soft);
  transition: all .3s ease;
}
.ps-step:hover .ps-icon {
  color: #fff;
  background: var(--citizen-blue);
  transform: translateY(-3px);
}
.ps-step h3 {
  margin: 0 0 6px;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: -.02em;
}
.ps-step p {
  margin: 0;
  color: var(--citizen-muted);
  font-size: 12px;
  line-height: 1.55;
  max-width: 200px;
  margin: 0 auto;
}

@media (max-width: 780px) {
  .process-steps-v2 { grid-template-columns: repeat(2, 1fr); }
  .ps-line { display: none; }
  .procedure-card-v2 { padding: 18px; gap: 14px; }
  .news-featured .nc-img-wrap { height: 200px; }
}
@media (max-width: 480px) {
  .process-steps-v2 { grid-template-columns: 1fr; }
  .nc-img-wrap { height: 180px; }
}
